<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="656" d:DesignHeight="876"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:domain="clr-namespace:WheelWizard.WiiManagement.GameLicense.Domain"
             xmlns:wwData="clr-namespace:WheelWizard.WheelWizardData.Domain"
             xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
             xmlns:miiAnimations="using:WheelWizard.MiiAnimations"
             xmlns:miiImages="clr-namespace:WheelWizard.MiiImages.Views"
             x:Class="WheelWizard.WheelWizardData.Views.FriendsPage"
             x:DataType="community:FriendsPage"
             xmlns:community="clr-namespace:WheelWizard.WheelWizardData.Views">
    <!-- THE FRIEND WALL: a grid of portrait cards. Online friends are awake in a lit, teal-rimmed portrait; offline
         ones sleep in a dimmed one; pending ones glare from a warm one. Clicking a card (or right-clicking it) opens
         everything you can do with that friend. -->
    <UserControl.Styles>
        <!-- CARD -->
        <Style Selector="Border.FriendCard">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FriendCard:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Neutral600}" />
        </Style>
        <Style Selector="Border.FriendCard.Online">
            <Setter Property="BorderBrush" Value="{StaticResource Primary700}" />
        </Style>
        <Style Selector="Border.FriendCard.Online:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Primary400}" />
        </Style>
        <Style Selector="Border.FriendCard.Pending">
            <Setter Property="BorderBrush" Value="{StaticResource Warning800}" />
        </Style>
        <Style Selector="Border.FriendCard.Pending:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Warning600}" />
        </Style>

        <!-- PORTRAIT: the Mii stands behind the bottom edge of the photo, like on the license -->
        <Style Selector="Border.FriendCard Panel.Portrait">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="{StaticResource Neutral800}" Offset="0" />
                    <GradientStop Color="#3A3D49" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Asleep (offline): asleep, at a calm frame rate, in a dimmed photo that lights up while hovered -->
        <Style Selector="Border.FriendCard miiImages|MiiAnimatedImage.Portrait">
            <Setter Property="Performance" Value="{x:Static miiAnimations:MiiPerformances.FriendOffline}" />
            <Setter Property="StillVariant" Value="{x:Static miiVars:MiiImageVariants.FriendsSideProfile}" />
            <Setter Property="MaxFramesPerSecond" Value="20" />
        </Style>
        <Style Selector="Border.FriendCard Border.NightShade">
            <Setter Property="Background" Value="{StaticResource Neutral950}" />
            <Setter Property="Opacity" Value="0.38" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FriendCard:pointerover Border.NightShade">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Awake (online) -->
        <Style Selector="Border.FriendCard.Online miiImages|MiiAnimatedImage.Portrait">
            <Setter Property="Performance" Value="{x:Static miiAnimations:MiiPerformances.FriendOnline}" />
            <Setter Property="MaxFramesPerSecond" Value="30" />
        </Style>
        <Style Selector="Border.FriendCard.Online Border.NightShade">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.FriendCard Border.TealGlow, Border.FriendCard Border.WarmGlow">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.FriendCard.Online:not(.Pending) Border.TealGlow">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Pending: their angry still picture, in a warm photo -->
        <Style Selector="Border.FriendCard.Pending miiImages|MiiAnimatedImage.Portrait">
            <Setter Property="Performance" Value="{x:Null}" />
            <Setter Property="StillVariant" Value="{x:Static miiVars:MiiImageVariants.FriendsSideProfilePending}" />
        </Style>
        <Style Selector="Border.FriendCard.Pending Border.NightShade">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.FriendCard.Pending Border.WarmGlow">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- View room: on the photo of a friend who's online -->
        <Style Selector="Border.FriendCard components|Button.RoomButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IconSize" Value="15" />
            <Setter Property="CornerRadius" Value="9999" />
        </Style>
        <Style Selector="Border.FriendCard.Online:not(.Pending) components|Button.RoomButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- NAME -->
        <Style Selector="Border.FriendCard TextBlock.FriendName">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Neutral300}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.FriendCard:pointerover TextBlock.FriendName, Border.FriendCard.Online TextBlock.FriendName">
            <Setter Property="Foreground" Value="{StaticResource Neutral50}" />
        </Style>

        <!-- The "more" dots: only while hovered, to say the card opens a menu -->
        <Style Selector="Border.FriendCard PathIcon.MoreHint">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.FriendCard:pointerover PathIcon.MoreHint">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- STATUS DOT AND FRIEND CODE -->
        <Style Selector="Border.FriendCard Ellipse.StatusDot">
            <Setter Property="Fill" Value="{StaticResource Neutral600}" />
        </Style>
        <Style Selector="Border.FriendCard.Online Ellipse.StatusDot">
            <Setter Property="Fill" Value="{StaticResource Primary300}" />
        </Style>
        <Style Selector="Border.FriendCard.Pending Ellipse.StatusDot">
            <Setter Property="Fill" Value="{StaticResource Warning400}" />
            <Setter Property="ToolTip.Tip" Value="Waiting for them to add you back" />
        </Style>
        <Style Selector="Border.FriendCard TextBlock.FriendCode">
            <Setter Property="Foreground" Value="{StaticResource Neutral500}" />
        </Style>
        <Style Selector="Border.FriendCard:pointerover TextBlock.FriendCode, Border.FriendCard.Online TextBlock.FriendCode">
            <Setter Property="Foreground" Value="{StaticResource Neutral300}" />
        </Style>

        <Style Selector="TextBlock.Status">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- HEADER -->
        <Style Selector="Ellipse#OnlineDot">
            <Setter Property="Fill" Value="{StaticResource Neutral600}" />
        </Style>
        <Style Selector="StackPanel.AnyOnline Ellipse#OnlineDot">
            <Setter Property="Fill" Value="{StaticResource Primary300}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <!-- This is the total height as the (Title + infoSection) - (padding) -->
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />

        <Border Grid.Row="1" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Spacing="6">
            <TextBlock Text="{loc:T page_title.friends}" Classes="PageTitleText" />
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,0,0"
                    ToolTip.Tip="{loc:T hover.friends_page_disclaimer}"
                    ToolTip.Placement="Top" ToolTip.ShowDelay="20"
                    Width="18" Height="18">
                <PathIcon Foreground="{StaticResource TitleIconColor}" Margin="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Data="{StaticResource InfoTip}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="VisibleWhenFriends" RowDefinitions="Auto,*" Margin="0,0,0,1">
            <!-- HEADER: who's around, and the order -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,14,6,6">
                <StackPanel Grid.Column="0" x:Name="CountLine" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="OnlineDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock FontSize="14" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"
                               TextWrapping="NoWrap">
                        <Run Text="{Binding OnlineCount}" FontWeight="SemiBold" Foreground="{StaticResource Neutral50}" />
                        <Run Text=" of " />
                        <Run Text="{Binding FriendCount}" FontWeight="SemiBold" Foreground="{StaticResource Neutral200}" />
                        <Run Text=" online" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T attribute.sort_by}" FontSize="13" Foreground="{StaticResource Neutral500}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <components:LinkButton x:Name="SortButton" FontSize="13" VerticalAlignment="Center"
                                           IconData="{StaticResource ChevronDown}" IconSize="9" IsIconLeft="False"
                                           Foreground="{StaticResource Neutral200}"
                                           HoverForeground="{StaticResource Neutral50}"
                                           Click="SortButton_OnClick">
                        <components:LinkButton.ContextMenu>
                            <ContextMenu x:Name="SortMenu" Placement="BottomEdgeAlignedRight"
                                         Opening="SortMenu_OnOpening" />
                        </components:LinkButton.ContextMenu>
                    </components:LinkButton>
                </StackPanel>
            </Grid>

            <!-- THE WALL -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsScrollInertiaEnabled="True">
                <!-- Not virtualized: a friend list holds at most 30, and a virtualizing panel rebuilds each card (and
                     restarts its live 3D Mii) every time it is scrolled back into view. -->
                <ItemsControl ItemsSource="{Binding FriendList}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="domain:FriendProfile">
                            <Border Classes="FriendCard"
                                    Classes.Online="{Binding IsOnline}"
                                    Classes.Pending="{Binding IsPending}"
                                    PointerReleased="Card_OnPointerReleased">
                                <Grid RowDefinitions="156,Auto">

                                    <!-- PHOTO -->
                                    <Panel Grid.Row="0" Classes="Portrait" ClipToBounds="True">
                                        <!-- Soft light behind the Mii. Gradients rather than a blur effect, which is
                                             costly to redraw next to a live Mii. -->
                                        <Border Classes="TealGlow" Width="250" Height="220" CornerRadius="9999"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="0,0,0,-110" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#468EFFE2" Offset="0" />
                                                    <GradientStop Color="#188EFFE2" Offset="0.5" />
                                                    <GradientStop Color="#008EFFE2" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Classes="WarmGlow" Width="250" Height="220" CornerRadius="9999"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="0,0,0,-110" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#36FFD80D" Offset="0" />
                                                    <GradientStop Color="#12FFD80D" Offset="0.5" />
                                                    <GradientStop Color="#00FFD80D" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <miiImages:MiiAnimatedImage Classes="Portrait" Width="184" Height="184"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                    Margin="0,-26,0,0"
                                                                    Mii="{Binding Mii}"
                                                                    LoadingColor="Transparent"
                                                                    FallBackColor="{StaticResource Neutral600}"
                                                                    ImageVariant="{x:Static miiVars:MiiImageVariants.FriendsSideProfileLive}" />

                                        <Border Classes="NightShade" />

                                        <ItemsControl ItemsSource="{Binding BadgeVariants}" IsVisible="{Binding HasBadges}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="wwData:BadgeVariant">
                                                    <community:CommunityBadge Variant="{Binding}" Width="22" Height="22" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <components:Button Classes="RoomButton" Variant="Primary"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                                                           IconData="{StaticResource Road}"
                                                           ToolTip.Tip="{loc:T action.view_room}"
                                                           ToolTip.Placement="Top" ToolTip.ShowDelay="20"
                                                           Click="ViewRoom_OnClick" />
                                    </Panel>

                                    <!-- NAME, FRIEND CODE, VR -->
                                    <StackPanel Grid.Row="1" Margin="12,9,10,11" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="FriendName" Text="{Binding NameOfMii}"
                                                       VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1" Classes="MoreHint" Data="{StaticResource ContextDots}"
                                                      Width="10" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Foreground="{StaticResource Neutral500}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Ellipse Classes="StatusDot" Width="7" Height="7"
                                                         VerticalAlignment="Center"
                                                         ToolTip.Placement="Top" ToolTip.ShowDelay="20" />
                                                <TextBlock Classes="Status FriendCode" Text="{Binding FriendCode}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                        Background="Transparent" VerticalAlignment="Center"
                                                        ToolTip.Tip="{loc:T attribute.vr_full}"
                                                        ToolTip.Placement="Top" ToolTip.ShowDelay="20">
                                                <TextBlock Classes="Status" Text="{Binding Vr}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Neutral200}" />
                                                <TextBlock Classes="Status" Text="{loc:T attribute.vr_abbreviation}"
                                                           FontSize="11" Foreground="{StaticResource Neutral500}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Everything you can do with a friend: on a click or a right-click of the card. -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T action.view_room}" IsVisible="{Binding IsOnline}"
                                                  FontWeight="SemiBold" Foreground="{StaticResource Primary300}"
                                                  Click="ViewRoom_OnClick" />
                                        <Separator IsVisible="{Binding IsOnline}" />
                                        <MenuItem Header="{loc:T action.copy_friend_code}" Click="CopyFriendCode_OnClick" />
                                        <MenuItem Header="{loc:T action.view_profile}" Click="ViewProfile_OnClick" />
                                        <MenuItem Header="View player on RWFC" Click="ViewOnRwfc_OnClick" />
                                        <Separator />
                                        <MenuItem Header="Remove Friend" Foreground="{StaticResource Danger400}"
                                                  Click="RemoveFriend_OnClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <components:EmptyPageInfo Grid.Row="1" x:Name="VisibleWhenNoFriends"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Title="{loc:T empty_content.no_friends_title}"
                                  BodyText="{loc:T empty_content.no_friends}" />
    </Grid>
</UserControl>

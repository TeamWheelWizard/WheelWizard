<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WheelWizard.Views.Components"
        xmlns:communityControls="clr-namespace:WheelWizard.WheelWizardData.Views">
    <Design.PreviewWith>
        <Border Padding="2" Background="{StaticResource Neutral950}">
            <UniformGrid Columns="5">
                <!-- Just so you know, the border is not necessary, its just here to also show the bounding box-->
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="RetroRewindDeveloper" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="WheelWizardDeveloper" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="MajorContributor" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="RWFCModerator" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="DiscordStaff" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="Contributor" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="Translator" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="Supporter" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="BetaTester" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="Heart" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="FireStarterGold" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="FireStarterSilver" />
                </Border>
                <Border Width="31" Height="31" Margin="5" CornerRadius="999" Background="{StaticResource Neutral900}">
                    <communityControls:CommunityBadge Variant="FireStarterBronze" />
                </Border>
            </UniformGrid>
        </Border>
    </Design.PreviewWith>


    <!--
    IMPORTANT:
        No actual pixel values are allowed to be used. So any positioning should be done through:
        - Grids, and then specifically a grid with ratio based layouts
        - Scale transforms
        - Rotate transforms
        - LOOK OUT WITH USING UNIFORM STRETCH, IT WORKS BAD, DON'T TOUCH THE AWARDS, they are made with uniform stretch lol, and they work but they can fall apart easily
    -->

    <Style Selector="communityControls|CommunityBadge">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border CornerRadius="999" Background="red" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Rounding each ratio column to whole pixels shifts the circles and icons off-centre at small sizes -->
        <Style Selector="^ /template/ :is(Control)">
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>

        <Style Selector="^ /template/ Grid">
            <Setter Property="ToolTip.Tip" Value="{TemplateBinding HoverTip}" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="ToolTip.ShowDelay" Value="20" />
        </Style>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=WheelWizardDeveloper]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="{StaticResource Brand100}" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="{StaticResource Brand400}" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{StaticResource Brand900}" Data="{StaticResource Code}"
                          Stretch="Uniform" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=RetroRewindDeveloper]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="{StaticResource Warning100}" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="{StaticResource Warning500}" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{StaticResource Warning800}" Data="{StaticResource Code}"
                          Stretch="Uniform" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=MajorContributor]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#C9F7D8" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#1E9E52" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#083A1C" Data="{StaticResource StarIcon}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=RWFCModerator]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="{StaticResource Danger100}" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="{StaticResource Danger500}" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{StaticResource Danger900}" Data="{StaticResource Shield}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=DiscordStaff]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#DCDFFD" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#5865F2" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#1C2160" Data="{StaticResource DiscordIcon}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=Contributor]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#C9F7D8" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#1E9E52" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#083A1C" Data="{StaticResource CubesStacked}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=Translator]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#E9C7FF" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#8A01CB" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#400C55" Data="{StaticResource Translation}"
                          Stretch="Uniform" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=Supporter]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#FFE0C2" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#E07B39" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#4A2209" Data="{StaticResource CoffeeIcon}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=BetaTester]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#C4F2EE" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#139C93" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#063936" Data="{StaticResource Flask}"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge[Variant=Heart]">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*,1*,10*,1*,1*" ColumnDefinitions="1*,1*,10*,1*,1*">
                    <Border Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="999" Grid.RowSpan="999" CornerRadius="999"
                            Background="#A7FCFF" />

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3" CornerRadius="999"
                            Background="#F0F0EC" />

                    <Path Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#72F2FF" Data="{StaticResource Heart}"
                          Height="15" Margin="0,2,0,0"
                          Stretch="Uniform" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- TOURNAMENT BADGES: every tournament shares these, the :gold/:silver/:bronze pseudo classes are set in code -->
    <Style Selector="communityControls|CommunityBadge:gold">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*, 2*, 2*" ColumnDefinitions="1*, 2*, 1*">
                    <Border Grid.Row="1" Grid.Column="1"
                            CornerRadius="999" Background="{StaticResource Warning100}" />

                    <Path Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
                          Fill="{StaticResource Warning600}" Data="{StaticResource Award}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="21" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge:silver">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*, 2*, 2*" ColumnDefinitions="1*, 2*, 1*">
                    <Border Grid.Row="1" Grid.Column="1"
                            CornerRadius="999" Background="{StaticResource Neutral50}" />

                    <Path Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
                          Fill="{StaticResource Neutral400}" Data="{StaticResource Award}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="21" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="communityControls|CommunityBadge:bronze">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="1*, 2*, 2*" ColumnDefinitions="1*, 2*, 1*">
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="999" Background="#FFD19D" />

                    <Path Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3"
                          Fill="#EC5616" Data="{StaticResource Award}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="21" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="656" d:DesignHeight="876"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
             xmlns:miiAnimations="using:WheelWizard.MiiAnimations"
             x:Class="WheelWizard.WheelWizardData.Views.UserProfilePage"
             x:DataType="community:UserProfilePage"
        xmlns:miiImages="clr-namespace:WheelWizard.MiiImages.Views"
        xmlns:community="clr-namespace:WheelWizard.WheelWizardData.Views">
    <UserControl.Styles>
        <!-- MII WINDOW -->
        <Style Selector="Border.ProfileWindow">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ProfileWindow.Online">
            <Setter Property="BorderBrush" Value="{StaticResource Primary600}" />
        </Style>

        <Style Selector="components|Button.WindowAction">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IconSize" Value="18" />
            <Setter Property="CornerRadius" Value="9999" />
        </Style>

    </UserControl.Styles>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <!-- This is the total height as the (Title + infoSection) - (padding) -->
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <Border Grid.Row="1" Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <TextBlock Grid.Row="0" Text="{loc:T page_title.my_profiles}" HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Classes="PageTitleText" />

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="18" Height="18" Margin="10,0,10,12"
                    ToolTip.Tip="{loc:T hover.region_user_selection}" ToolTip.Placement="Top"
                    ToolTip.ShowDelay="20">
                <PathIcon Foreground="{StaticResource TitleIconColor}" Margin="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Data="{StaticResource InfoTip}" />
            </Border>
            <ComboBox x:Name="RegionDropdown" Margin="3,0,0,10" MinWidth="160"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="ProfileContent" Margin="0,0,0,1"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <!-- Room at the top for the nametags on the peeking Miis. -->
            <StackPanel Margin="4,34,4,20">

                <!-- LICENSES: their Miis peek over the top of the card and hide behind it -->
                <ItemsControl x:Name="LicensePeekers" ItemsSource="{Binding LicenseTabs}" Height="96">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="community:LicenseTab">
                            <miiImages:MiiPeeker Mii="{Binding Mii}" IsActive="{Binding IsSelected}"
                                                 Click="LicensePeeker_OnClick">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9"
                                              VerticalAlignment="Center" IsVisible="{Binding IsPrimary}"
                                              ToolTip.Tip="{loc:T hover.primary_profile}" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </miiImages:MiiPeeker>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- MII WINDOW -->
                <Border Classes="ProfileWindow" Classes.Online="{Binding IsOnline}" Height="216">
                    <Grid>
                        <!-- Soft light behind the Mii while it's online. A gradient rather than a blur effect,
                             which is costly to redraw next to the live Mii. -->
                        <Border Width="340" Height="300" CornerRadius="9999"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-140"
                                IsVisible="{Binding IsOnline}" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#448EFFE2" Offset="0" />
                                    <GradientStop Color="#188EFFE2" Offset="0.5" />
                                    <GradientStop Color="#008EFFE2" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                            <Border.Styles>
                                <Style Selector="Border[IsVisible=True]">
                                    <Style.Animations>
                                        <Animation Duration="0:0:3" IterationCount="INFINITE"
                                                   PlaybackDirection="Alternate" Easing="SineEaseInOut">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="0.65" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="1" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>

                        <!-- The card is a window the Mii stands behind: its bottom edge is the sill. -->
                        <miiImages:MiiAnimatedImage x:Name="ProfileMii"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    Mii="{Binding CurrentMii}"
                                                    FallBackColor="{StaticResource Neutral700}"
                                                    Performance="{x:Static miiAnimations:MiiPerformances.ProfileWindow}"
                                                    MaxFramesPerSecond="60"
                                                    ImageVariant="{x:Static miiVars:MiiImageVariants.CurrentUserWindowLive}"
                                                    StillVariant="{x:Static miiVars:MiiImageVariants.CurrentUserSideProfile}" />

                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10"
                                    Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsOnline}">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Primary300}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T attribute.status_online}" FontSize="12"
                                       Foreground="{StaticResource Primary200}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Spacing="6">
                            <components:Button Classes="WindowAction"
                                               IconData="{StaticResource Shirt}"
                                               ToolTip.Tip="{loc:T action.change_mii}"
                                               Click="OpenMiiSelector_Click" />
                            <components:Button Classes="WindowAction" x:Name="ViewRoomButton"
                                               Variant="Primary"
                                               IconData="{StaticResource Road}"
                                               ToolTip.Tip="{loc:T action.view_room}"
                                               IsVisible="{Binding HasCurrentUserRoom}"
                                               Click="ViewRoom_OnClick" />
                        </StackPanel>

                        <StackPanel x:Name="BadgeContainer" Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />
                    </Grid>
                </Border>

                <!-- NAME & FRIEND CODE -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,14,2,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SelectableTextBlock x:Name="ProfileAttribUserName"
                                                 FontSize="22" FontWeight="Bold"
                                                 Foreground="{StaticResource Neutral50}"
                                                 VerticalAlignment="Center" />
                            <components:LinkButton VerticalAlignment="Center" x:Name="EditMiiName"
                                                   IconData="{StaticResource Pen}" IconSize="14"
                                                   ToolTip.Tip="{loc:T action.rename}"
                                                   Click="RenameMii_OnClick"
                                                   Foreground="{StaticResource Neutral600}"
                                                   HoverForeground="{StaticResource Neutral300}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" x:Name="FriendCodeRow">
                            <SelectableTextBlock x:Name="ProfileAttribFriendCode" FontSize="13"
                                                 Foreground="{StaticResource Neutral400}"
                                                 VerticalAlignment="Center" />
                            <components:LinkButton VerticalAlignment="Center" x:Name="CopyFcButton"
                                                   IconData="{StaticResource Copy}" IconSize="12"
                                                   ToolTip.Tip="{loc:T action.copy_friend_code}"
                                                   Click="CopyFriendCode_OnClick"
                                                   Foreground="{StaticResource Neutral600}"
                                                   HoverForeground="{StaticResource Neutral300}" />
                        </StackPanel>
                    </StackPanel>

                    <Panel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsPrimary}"
                                    Background="Transparent" ToolTip.Tip="{loc:T hover.primary_profile}">
                            <PathIcon Data="{StaticResource StarIcon}" Width="12" Height="12"
                                      Foreground="{StaticResource Primary400}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T state.primary}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Primary300}" VerticalAlignment="Center" />
                        </StackPanel>
                        <components:LinkButton Text="{loc:T option.make_primary}" FontSize="13"
                                               IconData="{StaticResource EmptyStarIcon}" IconSize="12"
                                               ToolTip.Tip="{loc:T hover.primary_profile}"
                                               Foreground="{StaticResource Neutral400}"
                                               HoverForeground="{StaticResource Neutral200}"
                                               IsVisible="{Binding !IsPrimary}"
                                               Click="MakePrimary_OnClick" />
                    </Panel>
                </Grid>

                <Border Background="{StaticResource BackgroundLineColor}" Height="1" Opacity="0.6" Margin="2,16,2,16" />

                <!-- VR HISTORY -->
                <ContentControl x:Name="HistoryHost" HorizontalContentAlignment="Stretch" Margin="2,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- repurposing the common state text -->
        <components:EmptyPageInfo Grid.Row="1" x:Name="NoProfilesInfo"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Title="{loc:T state.no_profiles}"
                                  BodyText="{loc:T empty_content.no_profiles}" />
    </Grid>
</UserControl>

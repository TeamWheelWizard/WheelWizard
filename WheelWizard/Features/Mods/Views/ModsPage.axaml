<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:patches="clr-namespace:WheelWizard.Features.Patches"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="876"
             x:Class="WheelWizard.Mods.Views.ModsPage"
             x:DataType="mods:ModsPage"
        xmlns:mods="clr-namespace:WheelWizard.Mods.Views">
    <UserControl.Styles>
        <Style Selector="Button.LibraryTitle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0,6,6,0">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LibraryTitle:focus-visible">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400}" />
        </Style>
        <Style Selector="Border.LibraryRow.Placeholder">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.LibraryRow">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Panel.LibraryGrip, Grid.LibraryRowMain">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Panel.LibraryGrip:pointerover, Grid.LibraryRowMain:pointerover">
            <Setter Property="Background" Value="{StaticResource Neutral700}" />
        </Style>
        <Style Selector="Border.LibraryRow">
            <Setter Property="Height" Value="50" />
        </Style>
        <Style Selector="mods|ModsPage.couch Border.LibraryRow">
            <Setter Property="Height" Value="76" />
        </Style>
        <Style Selector="StackPanel.CouchModActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="mods|ModsPage.couch StackPanel.CouchModActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="mods|ModsPage.couch StackPanel.DesktopModPriority">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UniformGrid">
            <Setter Property="Columns" Value="2" />
        </Style>
        <Style Selector="mods|ModsPage.couch UniformGrid">
            <Setter Property="Columns" Value="3" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="95" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <Border Grid.Row="1" Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="3,0,3,12" VerticalAlignment="Bottom">
            <StackPanel Spacing="6">
                <components:ToggleCheckBox Variant="Switch" x:Name="EnableAllCheckbox" Content="{loc:T action.enable_all}"
                                           HorizontalAlignment="Left" IsVisible="{Binding HasMods}" Click="ToggleButton_OnIsCheckedChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding StoragePageTitle}" Classes="PageTitleText" Margin="0" />
                    <components:StatusBadge Text="0" x:Name="ListItemCount" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <components:SplitButton Grid.Column="1" Text="{loc:T action.browse}" IconData="{StaticResource Search}"
                                    Tone="Secondary" Height="36" VerticalAlignment="Bottom" Click="BrowseMod_Click">
                <components:SplitButton.Flyout>
                    <MenuFlyout>
                        <components:SplitButtonItem Header="{loc:T action.browse}" IconData="{StaticResource Search}" Click="BrowseMod_Click" />
                        <components:SplitButtonItem Header="{loc:T action.import}" IconData="{StaticResource FileImport}" Click="ImportMod_Click" />
                    </MenuFlyout>
                </components:SplitButton.Flyout>
            </components:SplitButton>
        </Grid>

        <!-- Empty Mods Message -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="PageWithoutMods"
                    IsVisible="{Binding HasMods, Converter={x:Static BoolConverters.Not}}">
            <components:EmptyPageInfo Title="{loc:T empty_content.no_mods_title}"
                                      BodyText="{loc:T empty_content.no_mods}"
                                      HorizontalAlignment="Center" />
                        <components:SplitButton Text="{loc:T action.browse}" IconData="{StaticResource Search}" Tone="Brand" Height="40" Click="BrowseMod_Click" Margin="0,15,0,0">
                <components:SplitButton.Flyout>
                    <MenuFlyout>
                        <components:SplitButtonItem Header="{loc:T action.browse}" IconData="{StaticResource Search}" Click="BrowseMod_Click" />
                        <components:SplitButtonItem Header="{loc:T action.import}" IconData="{StaticResource FileImport}" Click="ImportMod_Click" />
                    </MenuFlyout>
                </components:SplitButton.Flyout>
            </components:SplitButton>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="PageWithMods" RowDefinitions="Auto,*" IsVisible="{Binding HasMods}">

            <ListBox Grid.Row="1" x:Name="ModsListBox" ItemsSource="{Binding Mods}" Margin="6,16,6,1" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Margin="0,0,0,68" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Classes="LibraryRow" Classes.Placeholder="{Binding IsPlaceholder}" Padding="0">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T action.rename}" Click="RenameMod_Click" />
                                        <MenuItem Header="{loc:T action.delete}" Click="DeleteMod_Click" />
                                        <Separator />
                                        <MenuItem Header="{loc:T action.convert_to_patches}"
                                                  IsEnabled="{Binding Mod.HasIncompatibleFiles}"
                                                  Click="ConvertToPatches_Click" />
                                        <Separator />
                                        <MenuItem Header="{loc:T action.view_mod}" Click="ViewMod_Click" />
                                        <MenuItem Header="{loc:T action.open_folder}" Click="OpenFolder_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Panel Grid.Column="0" Classes="LibraryGrip" Cursor="SizeAll"
                                           PointerPressed="DragHandle_PointerPressed">
                                        <PathIcon Data="{StaticResource Grip}" Width="12" Height="12"
                                                  Foreground="{StaticResource Neutral500}" />
                                    </Panel>
                                    <Border Grid.Column="1" Background="{StaticResource Neutral700}" />

                                    <Grid Grid.Column="2" Classes="LibraryRowMain" ColumnDefinitions="60,*,Auto">
                                        <Button Grid.ColumnSpan="3" Classes="LibraryTitle" Click="ViewMod_Click"
                                                AutomationProperties.Name="{Binding Mod.Title}" />
                                        <components:ToggleCheckBox Grid.Column="0" IsChecked="{Binding Mod.IsEnabled, Mode=TwoWay}"
                                                  Variant="Switch" Margin="0,5"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Mod.Title}" FontSize="14" Margin="8,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                                   Foreground="{StaticResource Neutral100}" />


                                        <!-- Commit priority edits on blur instead of on each keystroke. -->
                                        <StackPanel Grid.Column="2" Classes="DesktopModPriority" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <components:InputField Text="{Binding Mod.Priority, Mode=OneWay}"
                                                     TextChanged="PriorityText_OnTextChanged"
                                                     LostFocus="PriorityText_OnLostFocus" HorizontalContentAlignment="Center"
                                                     KeyDown="PriorityText_OnKeyDown"
                                                     MinWidth="25" MaxWidth="50" MinHeight="28" Height="28" Padding="2,0" VerticalAlignment="Center" VerticalContentAlignment="Center">
                                            </components:InputField>

                                            <Button Classes="LibraryTitle" IsVisible="{Binding Mod.HasIncompatibleFiles}" Width="16" Margin="8,0" VerticalAlignment="Center" Click="ViewMod_Click" AutomationProperties.Name="{loc:T action.view_mod}">
                                                <PathIcon Data="{StaticResource WarningTip}" Width="16" Height="16"
                                                          Foreground="{StaticResource Danger500}"
                                                          IsVisible="{Binding Mod.HasIncompatibleFiles}" ToolTip.Placement="Top">
                                            <ToolTip.Tip>
                                                <StackPanel MaxWidth="300">
                                                    <TextBlock Text="{x:Static patches:ModPatchCompatibilityText.IncompatibleTitle}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Neutral50}" />
                                                    <TextBlock Text="{x:Static patches:ModPatchCompatibilityText.IncompatibleMessage}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource Neutral100}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                                </PathIcon>
                                            </Button>
                                            <StackPanel Margin="10,0,0,0" Spacing="2">
                                                <components:ActionButton Tone="Secondary" HorizontalAlignment="Right"
                                                                   Size="Compact" MinHeight="20" Height="20" Padding="6,0"
                                                                   IsEnabled="{Binding IsLowest, Converter={x:Static BoolConverters.Not}}"
                                                                   Click="ButtonUp_OnClick">
                                                    <PathIcon Data="{StaticResource Chevron}" Width="15" Height="15"
                                                              RenderTransform="rotate(180deg)" RenderTransformOrigin="50%,50%" />
                                                </components:ActionButton>
                                                <components:ActionButton Tone="Secondary" HorizontalAlignment="Right"
                                                                   IconData="{StaticResource Chevron}" Size="Compact" MinHeight="20" Height="20" Padding="6,0"
                                                                   IsEnabled="{Binding IsHighest, Converter={x:Static BoolConverters.Not}}"
                                                                   Click="ButtonDown_OnClick" />


                                            </StackPanel>

                                        </StackPanel>

                                    </Grid>
                                    <StackPanel Grid.Column="3" Classes="CouchModActions" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
                                        <components:ActionButton Tag="move-up" Tone="Secondary" Variant="Ghost" IconData="{StaticResource ArrowUp}" AutomationProperties.Name="{loc:T couch.move_up}" MinHeight="44" MinWidth="44"
                                                                 IsEnabled="{Binding IsLowest, Converter={x:Static BoolConverters.Not}}" Click="ButtonUp_OnClick" />
                                        <components:ActionButton Tag="move-down" Tone="Secondary" Variant="Ghost" IconData="{StaticResource ArrowDown}" AutomationProperties.Name="{loc:T couch.move_down}" MinHeight="44" MinWidth="44"
                                                                 IsEnabled="{Binding IsHighest, Converter={x:Static BoolConverters.Not}}" Click="ButtonDown_OnClick" />
                                        <components:ActionButton Tag="more-actions" Tone="Secondary" Variant="Ghost" Text="…" AutomationProperties.Name="{loc:T action.more_actions}" MinHeight="44" MinWidth="44" Click="ModActions_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Rectangle IsVisible="{Binding IsPlaceholder}" IsHitTestVisible="False" Margin="0,3"
                                       RadiusX="6" RadiusY="6" Stroke="{StaticResource Brand400}" StrokeThickness="1.5" StrokeDashArray="4,3" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Mods Grid (Rows / priority text mode) -->
            <ScrollViewer Grid.Row="1" x:Name="ModsGridView" IsVisible="False" Margin="4,16,4,1"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Top">
                <ItemsControl x:Name="ModsGridItems" ItemsSource="{Binding Mods}" VerticalAlignment="Top" Margin="0,0,0,68">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <StackPanel>
                                    <mods:GridModPanel ViewRequested="ViewMod_Click" DragRequested="DragHandle_PointerPressed" />
                                    <StackPanel Classes="CouchModActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="4,0,4,12">
                                        <components:ActionButton Tag="move-up" Tone="Secondary" Variant="Ghost" IconData="{StaticResource ArrowUp}" AutomationProperties.Name="{loc:T couch.move_up}" MinHeight="44" MinWidth="44"
                                                                 IsEnabled="{Binding IsLowest, Converter={x:Static BoolConverters.Not}}" Click="ButtonUp_OnClick" />
                                        <components:ActionButton Tag="move-down" Tone="Secondary" Variant="Ghost" IconData="{StaticResource ArrowDown}" AutomationProperties.Name="{loc:T couch.move_down}" MinHeight="44" MinWidth="44"
                                                                 IsEnabled="{Binding IsHighest, Converter={x:Static BoolConverters.Not}}" Click="ButtonDown_OnClick" />
                                        <components:ActionButton Tag="more-actions" Tone="Secondary" Variant="Ghost" Text="…" AutomationProperties.Name="{loc:T action.more_actions}" MinHeight="44" MinWidth="44" Click="ModActions_OnClick" />
                                    </StackPanel>
                                </StackPanel>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T action.rename}" Click="RenameMod_Click" />
                                        <MenuItem Header="{loc:T action.delete}" Click="DeleteMod_Click" />
                                        <Separator />
                                        <MenuItem Header="{loc:T action.convert_to_patches}"
                                                  IsEnabled="{Binding Mod.HasIncompatibleFiles}"
                                                  Click="ConvertToPatches_Click" />
                                        <Separator />
                                        <MenuItem Header="{loc:T action.view_mod}" Click="ViewMod_Click" />
                                        <MenuItem Header="{loc:T action.open_folder}" Click="OpenFolder_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <components:SegmentedControl Grid.Row="1" x:Name="ViewModeToggle" ZIndex="10" Variant="Light"
                                          Margin="0,0,12,12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          SelectionChanged="ModsView_OnSelectionChanged">
                <components:SegmentOption x:Name="GridViewOption" IconData="{StaticResource Grid2x2}" AutomationProperties.Name="Grid view" ToolTip.Tip="Grid view" Width="40" Height="40" />
                <components:SegmentOption x:Name="ListViewOption" IconData="{StaticResource Rows3}" AutomationProperties.Name="List view" ToolTip.Tip="List view" Width="40" Height="40" />
            </components:SegmentedControl>

        </Grid>

        <!-- Drag-and-drop overlay canvas -->
        <Canvas x:Name="DragCanvas" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"
                Grid.RowSpan="2" ZIndex="1000" />
    </Grid>
</UserControl>

<UserControl x:Class="WheelWizard.Mods.Views.Dialogs.ModContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             ClipToBounds="False"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignHeight="670" d:DesignWidth="550"
        xmlns:modDialogs="clr-namespace:WheelWizard.Mods.Views.Dialogs">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <components:Spinner x:Name="LoadingView" Width="90" Height="90" IsVisible="False" />

        <components:EmptyPageInfo x:Name="NoDetailsView" IsVisible="False"
                                  Title="{loc:T empty_content.no_mod_selected_title}" BodyText="{loc:T empty_content.no_mod_selected}"
                                  IconData="{StaticResource Banana}" />

        <Grid x:Name="DetailsView"
              RowDefinitions="140,70,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">

            <!-- BANNER START -->
            <Border Grid.Row="0" x:Name="BannerBackgroundColor" Margin="{StaticResource NegativeEdgeGap}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Neutral900}" />
            <Image Grid.Row="0" x:Name="BannerImage" Margin="{StaticResource NegativeEdgeGap}"
                   Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Top" />

            <Border Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Background="{StaticResource BackgroundColor}"
                    Margin="{StaticResource NegativeEdgeGap}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#FFFFFFDF" Offset="0.8" />
                        <GradientStop Color="White" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <Grid Grid.Row="0">
                <TextBlock Text="Mod Title" x:Name="ModTitle" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Classes="PageTitleText" Margin="3" />

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <components:StatusBadge x:Name="LikesCountBox" Text="0" TipText="{loc:T attribute.likes}"
                                         IconData="{StaticResource Heart}"
                                         TipPlacement="Top" Margin="3" />
                    <components:StatusBadge x:Name="ViewsCountBox" Text="0" TipText="{loc:T attribute.views}"
                                         IconData="{StaticResource Eye}"
                                         TipPlacement="Top" Margin="3" />
                    <components:StatusBadge x:Name="DownloadsCountBox" Text="0" TipText="{loc:T attribute.downloads}"
                                         IconData="{StaticResource Download}"
                                         TipPlacement="Top" Margin="3" />
                </StackPanel>
            </Grid>
            <!-- BANNER END -->

            <!-- OTHER HEADER STUFF START -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                    <components:ActionButton
                        Text="somebody" x:Name="AuthorButton"
                        IconData="{StaticResource User}" FontSize="13" Click="AuthorLink_Click"  Tone="Brand" Variant="Link" Padding="0" MinHeight="0"/>
                    <components:ActionButton Margin="10,0,0,0"
                                                IsIconLeft="False" Text="{loc:T action.gamebanana_page}"
                                                IconData="{StaticResource ExternalLink}" FontSize="13" Click="GameBananaLink_Click"  Tone="Brand" Variant="Link" Padding="0" MinHeight="0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <components:ActionButton
                        x:Name="InstallButton" Text="{loc:T action.install}" Margin="3,0"
                        Click="Install_Click"  Tone="Brand"/>
                    <components:ActionButton
                        x:Name="UnInstallButton" Text="{loc:T action.un_install}" Margin="3,0"
                        Click="UnInstall_Click"  Tone="Danger"/>
                </StackPanel>

                <components:ActionButton
                                            Text="{loc:T action.report}" x:Name="ReportButton"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" IsIconLeft="False"
                                            IconData="{StaticResource WarningTip}" FontSize="13" Click="ReportLink_Click"  Tone="Danger" Variant="Link" Padding="0" MinHeight="0"/>
            </Grid>
            <!-- OTHER HEADER STUFF END -->

            <Border Grid.Row="2" CornerRadius="6" Background="{StaticResource Neutral900}"
                    Margin="0,10,0,0" Padding="6">
                <ScrollViewer>
                    <StackPanel>
                        <!-- Image Carousel -->
                        <components:FormFieldLabel x:Name="ImageLabel"/>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ImageCarousel" Margin="0,0,0,10" MaxHeight="170">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="modDialogs:ModItem">
                                        <Image Source="{Binding FullImageUrl}"
                                               Height="150"
                                               Margin="5"
                                               Stretch="Uniform" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <components:FormFieldLabel x:Name="DescriptionLabel" />


                        <html:HtmlPanel x:Name="ModDescriptionHtmlPanel" Margin="0,5,0,10">
                            <html:HtmlPanel.BaseStylesheet>
                                body {
                                color: #B4B8C5;
                                }
                                a {
                                color: #34EAC5;
                                }
                                a:hover {
                                color: #C7FFF0;
                                }

                                .BlueColor { color: #3489AA }
                                .GreenColor { color: #34EA3A }
                                .OrangeColor { color: #EA9834 }
                                .GreyColor { color: #6C7389 }
                                .RedColor { color: #F7524D }
                                .PurpleColor { color: #9A4DF7 }
                            </html:HtmlPanel.BaseStylesheet>
                        </html:HtmlPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
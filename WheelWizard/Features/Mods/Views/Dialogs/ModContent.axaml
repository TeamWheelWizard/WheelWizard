<UserControl x:Class="WheelWizard.Mods.Views.Dialogs.ModContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:modViews="clr-namespace:WheelWizard.Mods.Views"
             xmlns:viewModels="clr-namespace:WheelWizard.Mods.ViewModels">
    <UserControl.Styles>
        <Style Selector="ScrollViewer#DetailsScroll /template/ ScrollContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="ScrollViewer#DetailsScroll /template/ ScrollBar#PART_VerticalScrollBar">
            <Setter Property="RenderTransform"><TranslateTransform X="0" /></Setter>
        </Style>
        <Style Selector="ScrollViewer#DetailsScroll /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource Neutral600}" />
        </Style>
        <Style Selector="ScrollViewer#DetailsScroll /template/ Thumb:pointerover, ScrollViewer#DetailsScroll /template/ Thumb:pressed">
            <Setter Property="Background" Value="{StaticResource Neutral400}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ControlTheme x:Key="ScreenshotThumbnail" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4,0,4,4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="7" Padding="3">
                        <Border CornerRadius="3" ClipToBounds="True" Background="{StaticResource Neutral950}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{StaticResource Neutral500}" /></Style>
            <Style Selector="^:selected, ^:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource Brand300}" /></Style>
        </ControlTheme>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <components:ModalHeading>
            <TextBlock x:Name="ModTitle" Text="{loc:T empty_content.no_mod_selected_title}"
                       FontSize="24" FontWeight="Bold" LineHeight="29" MaxHeight="58"
                       Foreground="{StaticResource Neutral50}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding #ModTitle.Text}" />
        </components:ModalHeading>
        <components:Spinner Grid.Row="1" x:Name="LoadingView" Width="36" Height="36" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        <components:EmptyPageInfo Grid.Row="1" x:Name="NoDetailsView" IsVisible="False"
                                  Title="{loc:T empty_content.no_mod_selected_title}"
                                  BodyText="{loc:T empty_content.no_mod_selected}" IconData="{StaticResource Banana}" />
        <Grid Grid.Row="1" x:Name="DetailsView" RowDefinitions="Auto,*,Auto" RowSpacing="12" IsVisible="False">
            <StackPanel x:Name="DetailsHeader" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <WrapPanel x:Name="ModLinks">
                        <components:ActionButton x:Name="AuthorButton" IconData="{StaticResource User}"
                                                 Tone="Brand" Variant="Link" Padding="0" MinHeight="0" FontSize="13"
                                                 Margin="0,0,16,6" MaxWidth="160" Click="AuthorLink_Click">
                            <TextBlock x:Name="AuthorName" TextTrimming="CharacterEllipsis" />
                        </components:ActionButton>
                        <components:ActionButton x:Name="GameButton" Tone="Brand" Variant="Link" Padding="0" MinHeight="0"
                                                 FontSize="13" Margin="0,0,16,6" MaxWidth="180" Click="GameLink_Click">
                            <TextBlock x:Name="GameName" TextTrimming="CharacterEllipsis" />
                        </components:ActionButton>
                        <components:ActionButton Text="{loc:T action.gamebanana_page}" IconData="{StaticResource ExternalLink}"
                                                 Tone="Brand" Variant="Link" Padding="0" MinHeight="0" FontSize="13"
                                                 Margin="0,0,0,6" Click="GameBananaLink_Click" />
                    </WrapPanel>
                    <components:ActionButton Grid.Column="1" x:Name="ReportButton" Text="{loc:T action.report}"
                                             IconData="{StaticResource WarningTip}" IsIconLeft="False"
                                             Tone="Danger" Variant="Link" Padding="0" MinHeight="0" FontSize="13"
                                             VerticalAlignment="Top" Click="ReportLink_Click" />
                </Grid>
                <WrapPanel x:Name="ModStats" HorizontalAlignment="Right">
                    <components:StatusBadge x:Name="CategoryBadge" Variant="Dark" Margin="6,0,0,0" />
                    <components:StatusBadge x:Name="VersionBadge" Variant="Dark" Margin="6,0,0,0" />
                    <components:StatusBadge x:Name="LikesCountBox" TipText="{loc:T attribute.likes}"
                                            IconData="{StaticResource Heart}" Margin="6,0,0,0" />
                    <components:StatusBadge x:Name="ViewsCountBox" TipText="{loc:T attribute.views}"
                                            IconData="{StaticResource Eye}" Margin="6,0,0,0" />
                    <components:StatusBadge x:Name="DownloadsCountBox" TipText="{loc:T attribute.downloads}"
                                            IconData="{StaticResource Download}" Margin="6,0,0,0" />
                </WrapPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" x:Name="DetailsScroll" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0,0,8,16">
                    <StackPanel x:Name="ImagesSection" Spacing="8" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <components:FormFieldLabel Text="{loc:T attribute.images}" VerticalAlignment="Center" />
                            <components:Spinner Grid.Column="1" x:Name="ImagesLoading" Width="16" Height="16" IsVisible="False" />
                            <TextBlock Grid.Column="2" x:Name="ImagePosition" FontSize="12" Foreground="{StaticResource Neutral400}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="BannerContainer">
                            <Border x:Name="BannerFrame" Height="260" Width="464" MaxWidth="{Binding #BannerContainer.Bounds.Width}"
                                    HorizontalAlignment="Center" CornerRadius="8" ClipToBounds="True"
                                    BorderBrush="{StaticResource Neutral700}" BorderThickness="1"
                                    Background="{StaticResource Neutral950}" IsVisible="False">
                                <Border CornerRadius="7" ClipToBounds="True">
                                    <Panel>
                                        <Image x:Name="BannerImage" Stretch="Uniform" />
                                        <modViews:ModImagePlaceholder x:Name="BannerLoading" IsVisible="False" />
                                        <PathIcon x:Name="BannerUnavailable" Data="{StaticResource WarningTip}" Width="28" Height="28"
                                                  Foreground="{StaticResource Neutral500}" IsVisible="False" ToolTip.Tip="Image unavailable" />
                                    </Panel>
                                </Border>
                            </Border>
                        </Grid>
                        <Grid x:Name="GalleryNavigation" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalAlignment="Center">
                            <components:ActionButton x:Name="PreviousImage" VerticalAlignment="Center" Size="Compact" Variant="Ghost" Tone="Secondary"
                                                     Padding="6" Click="PreviousImage_Click" AutomationProperties.Name="Previous image">
                                <PathIcon Data="{StaticResource Chevron}" Width="12" Height="12" RenderTransform="rotate(90deg)" />
                            </components:ActionButton>

                            <ListBox Grid.Column="1" x:Name="ImageCarousel" Background="Transparent" BorderThickness="0" Padding="0"
                                     SelectionMode="Single" SelectionChanged="ImageCarousel_SelectionChanged"
                                     RequestBringIntoView="ImageCarousel_RequestBringIntoView"
                                     ItemContainerTheme="{StaticResource ScreenshotThumbnail}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="viewModels:ModScreenshotViewModel">
                                        <Panel Width="100" Height="62" ToolTip.Tip="{Binding Label}">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Label}" />
                                            <modViews:ModImagePlaceholder IsVisible="{Binding IsLoading}" />
                                            <PathIcon Data="{StaticResource WarningTip}" Width="16" Height="16"
                                                      Foreground="{StaticResource Neutral500}" IsVisible="{Binding HasFailed}" />
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <components:ActionButton Grid.Column="2" x:Name="NextImage" VerticalAlignment="Center" Size="Compact" Variant="Ghost" Tone="Secondary"
                                                     Padding="6" Click="NextImage_Click" AutomationProperties.Name="Next image">
                                <PathIcon Data="{StaticResource Chevron}" Width="12" Height="12" RenderTransform="rotate(-90deg)" />
                            </components:ActionButton>

                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <Border Height="0.5" UseLayoutRounding="False" Background="{StaticResource BackgroundLineColor}" />

                        <Border ClipToBounds="True">
                            <html:HtmlPanel x:Name="ModDescriptionHtmlPanel">
                                <html:HtmlPanel.BaseStylesheet>
                                    body { color: #B4B8C5; font-size: 14px; }
                                    a { color: #34EAC5; }
                                    a:hover { color: #C7FFF0; }
                                    img { max-width: 100%; }
                                    .BlueColor { color: #3489AA }
                                    .GreenColor { color: #34EA3A }
                                    .OrangeColor { color: #EA9834 }
                                    .GreyColor { color: #6C7389 }
                                    .RedColor { color: #F7524D }
                                    .PurpleColor { color: #9A4DF7 }
                                </html:HtmlPanel.BaseStylesheet>
                            </html:HtmlPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BackgroundLineColor}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <WrapPanel HorizontalAlignment="Right">
                    <components:ActionButton x:Name="UnInstallButton" Text="{loc:T action.un_install}"
                                             Click="UnInstall_Click" Tone="Danger" Variant="Ghost" Margin="0,0,8,0" />
                    <components:ActionButton x:Name="InstallButton" Text="{loc:T action.download_and_install}"
                                             IconData="{StaticResource Download}" Click="Install_Click" Tone="Brand" />
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

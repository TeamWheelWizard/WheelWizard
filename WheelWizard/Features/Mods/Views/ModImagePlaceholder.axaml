<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WheelWizard.Mods.Views"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             x:Class="WheelWizard.Mods.Views.ModImagePlaceholder"
             IsHitTestVisible="False" AutomationProperties.Name="{loc:T state.loading}">
    <UserControl.Styles>
        <Style Selector="views|ModImagePlaceholder[IsVisible=True] Border.Glint[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-180" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="800" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Border Background="{StaticResource Neutral800}" CornerRadius="4" ClipToBounds="True">
        <Border Classes="Glint" Width="160" HorizontalAlignment="Left" IsVisible="{DynamicResource ControlAnimationsEnabled}">
            <Border.RenderTransform><TranslateTransform X="-180" /></Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#18FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Border>
</UserControl>

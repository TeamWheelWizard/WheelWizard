<dialogBase:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                   x:Class="WheelWizard.WiiManagement.MiiManagement.Views.Dialogs.MiiEditorWindow"
                   x:DataType="miiDialogs:MiiEditorWindow" ClipToBounds="False"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base"
        xmlns:miiDialogs="clr-namespace:WheelWizard.WiiManagement.MiiManagement.Views.Dialogs">
    <Grid Height="460" ColumnDefinitions="370,20,450" ClipToBounds="False">
        <Border Grid.Column="0" CornerRadius="{StaticResource GlobalCornerRadius}" VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch" Background="{StaticResource Neutral900}">
           <ContentPresenter x:Name="EditorPresenter"/>
       </Border>
       <Border Grid.Column="1" Background="{StaticResource BackgroundLineColor}" Margin="0,-10"
               Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

       <!-- The live 3D Mii (MiiEditorStage) is added here in code. -->
       <Border Grid.Column="2" x:Name="StageHost" ClipToBounds="True" />
    </Grid>
</dialogBase:PopupContent>

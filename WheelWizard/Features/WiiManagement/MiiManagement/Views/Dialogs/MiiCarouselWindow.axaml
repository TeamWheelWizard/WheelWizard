<dialogBase:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" ClipToBounds="False"
                   x:Class="WheelWizard.WiiManagement.MiiManagement.Views.Dialogs.MiiCarouselWindow"
        xmlns:miiImages="clr-namespace:WheelWizard.MiiImages.Views"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base">
    <Grid Width="440" Height="300">
        <components:LoadingIcon HorizontalAlignment="Center" VerticalAlignment="Center" Width="180" Height="180"
                                x:Name="MiiLoadingIcon" Foreground="{StaticResource Neutral800}" />
        <miiImages:Mii3DRender x:Name="Carousel" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="280"
                              ImageVariant="{x:Static miiVars:MiiImageVariants.FullBodyCarousel}"/>
    </Grid>
</dialogBase:PopupContent>

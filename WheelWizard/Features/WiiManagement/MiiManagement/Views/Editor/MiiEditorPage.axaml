<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="820"
             x:Class="WheelWizard.WiiManagement.MiiManagement.Views.Editor.MiiEditorPage"
             Focusable="True" ClipToBounds="False">
    <UserControl.Resources>
        <StreamGeometry x:Key="MiiEditorMoleIcon">M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 Z M12,4 A8,8 0 1 1 4,12 A8,8 0 0 1 12,4 Z M13.8,14 A1.9,1.9 0 1 0 17.6,14 A1.9,1.9 0 1 0 13.8,14 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorFeatureIcon">M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 Z M12,4 A8,8 0 1 1 4,12 A8,8 0 0 1 12,4 Z M5.6,13.4 L8.6,12.4 L9,13.5 L6,14.5 Z M6.4,15.6 L9.4,14.6 L9.8,15.7 L6.8,16.7 Z M18.4,13.4 L15.4,12.4 L15,13.5 L18,14.5 Z M17.6,15.6 L14.6,14.6 L14.2,15.7 L17.2,16.7 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorBiggerIcon">M3,3 L10,3 L10,5.4 L7.1,5.4 L10.9,9.2 L9.2,10.9 L5.4,7.1 L5.4,10 L3,10 Z M21,21 L14,21 L14,18.6 L16.9,18.6 L13.1,14.8 L14.8,13.1 L18.6,16.9 L18.6,14 L21,14 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorSmallerIcon">M10.5,10.5 L3.5,10.5 L3.5,8.1 L6.4,8.1 L2.6,4.3 L4.3,2.6 L8.1,6.4 L8.1,3.5 L10.5,3.5 Z M13.5,13.5 L20.5,13.5 L20.5,15.9 L17.6,15.9 L21.4,19.7 L19.7,21.4 L15.9,17.6 L15.9,20.5 L13.5,20.5 Z</StreamGeometry>
        <!-- Figures at the ends of the body sliders. -->
        <StreamGeometry x:Key="MiiEditorTallIcon">M9,4 A3,3 0 1 0 15,4 A3,3 0 1 0 9,4 Z M8.5,23 L8.5,11.5 A3.5,3.5 0 0 1 15.5,11.5 L15.5,23 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorShortIcon">M9,11 A3,3 0 1 0 15,11 A3,3 0 1 0 9,11 Z M8.5,23 L8.5,18.5 A3.5,3.5 0 0 1 15.5,18.5 L15.5,23 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorWideIcon">M9,5 A3,3 0 1 0 15,5 A3,3 0 1 0 9,5 Z M5,22 L5,13 A4,4 0 0 1 9,9 L15,9 A4,4 0 0 1 19,13 L19,22 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorThinIcon">M9,5 A3,3 0 1 0 15,5 A3,3 0 1 0 9,5 Z M9.5,22 L9.5,11.5 A2.5,2.5 0 0 1 14.5,11.5 L14.5,22 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorChevronLeft">M15.4,3.4 L17.4,5.4 L10.8,12 L17.4,18.6 L15.4,20.6 L6.8,12 Z</StreamGeometry>
        <StreamGeometry x:Key="MiiEditorChevronRight">M8.6,3.4 L17.2,12 L8.6,20.6 L6.6,18.6 L13.2,12 L6.6,5.4 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Floating panels over the Mii. -->
        <Style Selector="Border.Floating">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BoxShadow" Value="0 6 22 0 #59000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.Floating.hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- Floating without a card behind it (the sliders, and the colour button while it's closed). -->
        <Style Selector="Border.Floating.Bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>

        <Style Selector="components|MultiIconRadioButton.Side">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
        </Style>
        <Style Selector="components|MultiIconRadioButton.Variant">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
        </Style>

        <!-- Round buttons floating next to the Mii (arrows, add/remove, size and rotate). -->
        <Style Selector="Button.Round">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Neutral800}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral600}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Round /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="19" />
        </Style>
        <Style Selector="Button.Round:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Primary600}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary400}" />
        </Style>
        <Style Selector="Button.Round:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>
        <Style Selector="Button.Round:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.Round PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.Round.Arrow">
            <Setter Property="Background" Value="#CC1B1D22" />
        </Style>
        <Style Selector="Button.Round.Add">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{StaticResource Primary600}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary300}" />
        </Style>
        <Style Selector="Button.Round.Remove">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{StaticResource Danger600}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger400}" />
        </Style>

        <!-- Upright body sliders. -->
        <Style Selector="StackPanel.BodySlider">
            <Setter Property="Width" Value="44" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="StackPanel.BodySlider PathIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Neutral200}" />
        </Style>
        <Style Selector="StackPanel.BodySlider PathIcon.Low">
            <Setter Property="Foreground" Value="{StaticResource Neutral400}" />
        </Style>
        <Style Selector="StackPanel.BodySlider Slider">
            <Setter Property="Height" Value="210" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Colour swatches. -->
        <Style Selector="Button.Swatch">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}" />
        </Style>
        <Style Selector="Button.Swatch /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.Swatch:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Neutral200}" />
        </Style>
        <Style Selector="Button.Swatch.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource Primary300}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" RowDefinitions="*,Auto">
        <!-- The 3D Mii (MiiEditorScene) is added here in code. -->
        <Panel x:Name="StageHost" Grid.Row="0" ClipToBounds="False" />

        <!-- Buttons that float next to parts of the Mii (positioned every frame). -->
        <Canvas x:Name="Overlay" Grid.Row="0" ClipToBounds="False" />

        <!-- Back to My Miis, like going back from a room's details. -->
        <components:LinkButton x:Name="BackButton" Grid.Row="0"
                               IconData="{StaticResource ArrowLeft}"
                               Text="{loc:T page_title.my_miis}"
                               Foreground="{StaticResource TitleTextColor}"
                               HoverForeground="{StaticResource Primary200}"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               FontSize="16" Click="BackButton_OnClick" />

        <StackPanel x:Name="TopActions" Grid.Row="0" Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="UndoButton" Classes="Round" Click="UndoButton_OnClick"
                    ToolTip.Tip="{loc:T action.undo}">
                <PathIcon Data="{StaticResource RotateLeft}" />
            </Button>
            <Button x:Name="RedoButton" Classes="Round" Click="RedoButton_OnClick"
                    ToolTip.Tip="{loc:T action.redo}">
                <PathIcon Data="{StaticResource RotateRight}" />
            </Button>
            <components:Button x:Name="SaveButton" Variant="Primary" Margin="4,0,0,0"
                               IconData="{StaticResource CheckMark}" IconSize="14"
                               Text="{loc:T action.save}" Click="SaveButton_OnClick" />
        </StackPanel>

        <!-- The floating sidebar: Head / Body / Info, then the head groups, then a group's parts. -->
        <Border x:Name="SidebarPanel" Grid.Row="0" Classes="Floating"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,40,0,0">
            <StackPanel x:Name="SidebarItems" Spacing="2" />
        </Border>

        <!-- Size / rotate / flip for the selected part. -->
        <Border x:Name="ToolPanel" Grid.Row="0" Classes="Floating hidden"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,0,0" Padding="5">
            <StackPanel x:Name="ToolItems" Spacing="6" />
        </Border>

        <!-- Body: height and weight, as two upright sliders with a figure at each end (tall/short, wide/thin). -->
        <Border x:Name="BodyPanel" Grid.Row="0" Classes="Floating Bare hidden" Padding="6,12"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <StackPanel Classes="BodySlider" ToolTip.Tip="{loc:T attribute.mii.height}">
                    <PathIcon Data="{StaticResource MiiEditorTallIcon}" />
                    <Slider x:Name="HeightSlider" Orientation="Vertical" Minimum="0" Maximum="127"
                            ValueChanged="HeightSlider_OnValueChanged" />
                    <PathIcon Classes="Low" Data="{StaticResource MiiEditorShortIcon}" />
                </StackPanel>
                <StackPanel Classes="BodySlider" ToolTip.Tip="{loc:T attribute.mii.width}">
                    <PathIcon Data="{StaticResource MiiEditorWideIcon}" />
                    <Slider x:Name="WeightSlider" Orientation="Vertical" Minimum="0" Maximum="127"
                            ValueChanged="WeightSlider_OnValueChanged" />
                    <PathIcon Classes="Low" Data="{StaticResource MiiEditorThinIcon}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Info: names and favorite. -->
        <Border x:Name="InfoCard" Grid.Row="0" Classes="Floating hidden" Width="236" Padding="14,12"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,0,0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="TitleText" FontSize="18" Text="{loc:T attribute.mii_section.info}" VerticalAlignment="Center" />
                    <!-- Icon and colour come from styles only: set on the button itself they'd win over .favorite. -->
                    <components:LinkButton x:Name="FavoriteButton" Grid.Column="1" IconSize="22"
                                           HoverForeground="{StaticResource Warning300}" Click="FavoriteButton_OnClick"
                                           ToolTip.Tip="{loc:T action.favorite}">
                        <components:LinkButton.Styles>
                            <Style Selector="components|LinkButton">
                                <Setter Property="IconData" Value="{StaticResource EmptyStarIcon}" />
                                <Setter Property="Foreground" Value="{StaticResource Neutral400}" />
                            </Style>
                            <Style Selector="components|LinkButton.favorite">
                                <Setter Property="IconData" Value="{StaticResource StarIcon}" />
                                <Setter Property="Foreground" Value="{StaticResource Warning500}" />
                            </Style>
                        </components:LinkButton.Styles>
                    </components:LinkButton>
                </Grid>
                <StackPanel>
                    <components:FormFieldLabel Text="{loc:T attribute.mii.name}" />
                    <components:TextField x:Name="NameField" PlaceholderText="{loc:T placeholder.enter_mii_name}"
                                          TextChanged="NameField_OnTextChanged" />
                </StackPanel>
                <StackPanel>
                    <components:FormFieldLabel Text="{loc:T attribute.mii.creator_name}" />
                    <components:TextField x:Name="CreatorField" PlaceholderText="{loc:T helper_text.optional}"
                                          TextChanged="CreatorField_OnTextChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom: every variant of the selected part, and the colour button in the corner. -->
        <Grid x:Name="BottomBar" Grid.Row="1" Height="78" Margin="0,8,0,0">
            <Border x:Name="VariantPanel" Classes="Floating hidden" Margin="0,0,70,0" Padding="4">
                <ScrollViewer x:Name="VariantScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="VariantItems" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <Border x:Name="ColorPanel" Classes="Floating Bare hidden" HorizontalAlignment="Right" Width="62" Padding="6"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer x:Name="SwatchScroller" Opacity="0" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="4,0,8,0">
                        <StackPanel x:Name="SwatchItems" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                    </ScrollViewer>
                    <Button x:Name="ColorButton" Grid.Column="1" Classes="Swatch" Width="48" Height="48" CornerRadius="24"
                            Click="ColorButton_OnClick" ToolTip.Tip="{loc:T hover.mii_editor.color}">
                        <Border x:Name="ColorDot" Width="36" Height="36" CornerRadius="18" BorderThickness="2"
                                BorderBrush="{StaticResource Neutral900}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Picker: roll the dice instead of picking. -->
            <components:Button x:Name="DiceButton" Variant="Default" IsVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IconData="{StaticResource Dice}" IconSize="20"
                               Text="{loc:T action.surprise_me}" Click="DiceButton_OnClick" />
        </Grid>

        <StackPanel x:Name="PickerHint" Grid.Row="0" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0" Spacing="2">
            <TextBlock Classes="TitleText" FontSize="22" HorizontalAlignment="Center" Text="{loc:T text.pick_your_mii}" />
            <TextBlock Classes="BodyText" HorizontalAlignment="Center" Foreground="{StaticResource Neutral400}"
                       Text="{loc:T text.pick_your_mii_extra}" />
        </StackPanel>
    </Grid>
</UserControl>

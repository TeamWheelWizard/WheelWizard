<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:c="clr-namespace:WheelWizard.Views.Components"
             xmlns:vm="clr-namespace:WheelWizard.Online.ViewModels"
             xmlns:domain="clr-namespace:WheelWizard.Online.Domain"
             xmlns:rooms="clr-namespace:WheelWizard.RrRooms.Views"
             xmlns:models="clr-namespace:WheelWizard.Models.RRInfo"
             x:Class="WheelWizard.Online.Views.OnlinePage" x:DataType="vm:OnlineViewModel">
    <UserControl.Styles>
        <Style Selector="c|ToggleRadioButton.OnlineNav">
            <Setter Property="Foreground" Value="{StaticResource Neutral400}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="NavBackground" Background="Transparent">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="16,14,16,16" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="c|ToggleRadioButton.OnlineNav:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
        </Style>
        <Style Selector="c|ToggleRadioButton.OnlineNav:checked">
            <Setter Property="Foreground" Value="{StaticResource Brand300}" />
        </Style>
        <Style Selector="c|ToggleRadioButton.OnlineNav:checked /template/ Border#Underline">
            <Setter Property="Background" Value="{StaticResource Brand300}" />
        </Style>
        <Style Selector="c|ToggleRadioButton.OnlineNav:focus-visible /template/ Border#NavBackground">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="95,*,1">
        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1" VerticalAlignment="Bottom" />
        <Border Grid.Row="2" Background="{StaticResource BackgroundLineColor}" Height="1" />
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="3,0,3,12" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{StaticResource Brand300}" />
                <TextBlock Text="{loc:T text.live_rwfc}" Classes="TinyText" Foreground="{StaticResource Neutral300}" />
            </StackPanel>
            <TextBlock Text="{loc:T attribute.status_online}" Classes="PageTitleText" Margin="0" />
        </StackPanel>
        <c:InputField x:Name="PlayerSearch" Grid.Row="0" Width="245" HorizontalAlignment="Right"
                      VerticalAlignment="Bottom" Margin="3,0,3,12" IconData="{StaticResource Search}"
                      Placeholder="{loc:T placeholder.search_for_players}" TextChanged="Search_OnTextChanged" />
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border BorderBrush="{StaticResource BackgroundLineColor}" BorderThickness="0,0,0,1">
                <StackPanel x:Name="OnlineSections" Orientation="Horizontal">
                    <c:ToggleRadioButton x:Name="OverviewTab" Classes="OnlineNav" Content="Overview" IsCheckedChanged="Section_OnCheckedChanged" />
                    <c:ToggleRadioButton x:Name="RoomsTab" Classes="OnlineNav" Content="{loc:T page_title.rooms}" IsCheckedChanged="Section_OnCheckedChanged" />
                    <c:ToggleRadioButton x:Name="LeaderboardTab" Classes="OnlineNav" Content="{loc:T page_title.leaderboard}" IsCheckedChanged="Section_OnCheckedChanged" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid IsVisible="{Binding !IsSearching}">
                    <StackPanel x:Name="Overview" Margin="0,12" Spacing="10">
                            <Border BorderBrush="{StaticResource BackgroundLineColor}" BorderThickness="0,0,0,1" Padding="4,0,4,10">
                                <Grid ColumnDefinitions="*,1,*">
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Brand300}" />
                                            <TextBlock Text="{Binding PlayerCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Neutral100}" />
                                        </StackPanel>
                                        <TextBlock Text="Players online" Classes="TinyText" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource BackgroundLineColor}" />
                                    <StackPanel Grid.Column="2" Margin="22,0,0,0" Spacing="5">
                                        <TextBlock Text="{Binding RoomCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Neutral100}" />
                                        <TextBlock Text="Active rooms" Classes="TinyText" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <c:FormFieldLabel Text="{loc:T page_title.leaderboard}" VerticalAlignment="Center" />
                                    <c:ActionButton Grid.Column="1" Text="View all" Variant="Link" Tone="Secondary" Size="Compact" Click="ShowLeaderboard_OnClick" />
                                </Grid>
                                <ContentControl x:Name="Podium" Height="282" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Border Background="{StaticResource BackgroundLineColor}" Height="1" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <c:FormFieldLabel Text="{loc:T page_title.rooms}" VerticalAlignment="Center" />
                                    <c:ActionButton Grid.Column="1" Text="View all" Variant="Link" Tone="Secondary" Size="Compact" Click="ShowRooms_OnClick" />
                                </Grid>
                                <TextBlock IsVisible="{Binding !HasRooms}" Text="{loc:T empty_content.no_rooms_title}" Classes="BodyText" FontSize="14" Margin="0,12" />
                                <ListBox ItemsSource="{Binding RoomPreview}" SelectionChanged="Room_OnSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         Background="Transparent" BorderThickness="0" Padding="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:RrRoom">
                                            <rooms:RoomListItem Classes="Compact" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                    </StackPanel>
                    <ContentControl x:Name="SectionContent" IsVisible="False" />
                </Grid>
                <Grid IsVisible="{Binding IsSearching}" RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <c:FormFieldLabel Text="{Binding ResultCount}" />
                        <TextBlock Text="{Binding SearchMessage}" Classes="TinyText" TextWrapping="Wrap" />
                        <Border BorderBrush="{StaticResource BackgroundLineColor}" BorderThickness="0,0,0,1" Padding="53,8,18,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Name" Classes="TinyText" />
                                <TextBlock Grid.Column="1" Text="{loc:T attribute.vr_abbreviation}" Classes="TinyText" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                             Background="Transparent" BorderThickness="0" Padding="0" IsVisible="{Binding !IsLoading}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:OnlinePlayer">
                                <rooms:PlayerListItem Click="Player_OnClick" UserName="{Binding Name}" FriendCode="{Binding FriendCode}"
                                                      Vr="{Binding Vr}" Mii="{Binding Mii}" IsOnline="{Binding IsOnline}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <c:Spinner Grid.Row="1" IsVisible="{Binding IsLoading}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <c:EmptyPageInfo Grid.Row="1" IsVisible="{Binding IsEmpty}" Title="No players found" BodyText="Try another name or a full friend code." />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<dialogBase:ModalContent xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="876" d:DesignWidth="456"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             x:Class="WheelWizard.RrRooms.Views.RoomDetailsWindow"
             x:DataType="rooms:RoomDetailsWindow"
        xmlns:rooms="clr-namespace:WheelWizard.RrRooms.Views">
    <Grid Width="540" Height="700" MaxHeight="760" RowDefinitions="Auto,*">
        <components:ModalHeading Margin="0,0,0,16">
            <TextBlock Classes="TitleText" Text="{loc:T page_title.room_details}" />
        </components:ModalHeading>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Room.GameMode}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Neutral100}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Room.Id}" FontSize="12" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:T attribute.time_online}" Classes="TinyText" />
                            <TextBlock Text="{Binding Room.TimeOnline}" FontSize="14" Foreground="{StaticResource Neutral200}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{loc:T attribute.average_room_vr}" Classes="TinyText" />
                            <TextBlock Text="{Binding Room.AverageVr, StringFormat={}{0:N0}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Neutral100}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Border BorderBrush="{StaticResource BackgroundLineColor}" BorderThickness="0,1,0,1" Padding="0,12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Latest race" FontSize="11" Foreground="{StaticResource Neutral500}" />
                        <TextBlock Text="{Binding Room.RaceDescription}" FontSize="14" Foreground="{StaticResource Neutral200}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <components:FormFieldLabel Text="{loc:T list_title.players}" />
                    <TextBlock Text="{Binding Room.PlayerCount}" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="PlayersListView" SelectionMode="Single" BorderThickness="0"
                     Padding="0" Margin="0" Background="Transparent" ItemsSource="{Binding PlayersList}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <rooms:PlayerListItem Classes="RoomGrid" Click="ViewProfile_OnClick"
                            UserName="{Binding Name}"
                            FriendCode="{Binding FriendCode}"
                            Vr="{Binding VrDisplay}"
                            Mii="{Binding FirstMii}"
                            HasBadges="{Binding HasBadges}" BadgeVariants="{Binding BadgeVariants}">
                            <rooms:PlayerListItem.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:T action.copy_friend_code}" Click="CopyFriendCode_OnClick" />
                                    <Separator />
                                    <MenuItem Header="View Profile" Click="ViewProfile_OnClick" />
                                    <MenuItem Header="View player on RWFC" Click="ViewOnRwfc_OnClick" />
                                </ContextMenu>
                            </rooms:PlayerListItem.ContextMenu>
                        </rooms:PlayerListItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>
    </Grid>
</dialogBase:ModalContent>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Program Config -->
        <StartupObject>WheelWizard.Program</StartupObject>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>WheelWizard</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Program details -->
        <Version>2.5.9</Version>
        <Description>This program will manage RetroRewind and mods :)</Description>
        <Copyright>GNU v3.0</Copyright>
        <RepositoryUrl>https://github.com/patchzyy/WheelWizard</RepositoryUrl>
        <ApplicationIcon>car-wheel.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64'">
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Everything specifically for Avalonia -->
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
        <PackageReference Include="Avalonia.HtmlRenderer" Version="12.0.0" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
        <PackageReference Include="Avalonia.Wayland" Version="12.1.2" />
        <!-- Realtime (GPU) Mii rendering -->
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />

        <!-- Code analyzers -->
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Everything from the OG Wheel wizard project -->
        <PackageReference Include="ini-parser" Version="2.5.2" NoWarn="NU1701" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
        <PackageReference Include="Semver" Version="3.0.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="SharpCompress" Version="0.48.1" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
        <PackageReference Include="TestableIO.System.IO.Abstractions.Analyzers" Version="2022.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Testably.Abstractions" Version="9.0.0" />
        <PackageReference Include="YamlDotNet" Version="17.1.0" />
    </ItemGroup>

    <ItemGroup Label="Embedded Resources">
        <EmbeddedResource Include="Resources\Languages\*.yml" />

        <!-- Skinned 3DS Mii body used by the Mii animation player (MiiAnim.Core loads these by logical name). -->
        <EmbeddedResource Include="Features\MiiAnimation\Resources\MaleBody.glb" LogicalName="MiiAnim.Core.Assets.MaleBody.glb" />
        <EmbeddedResource Include="Features\MiiAnimation\Resources\FemaleBody.glb" LogicalName="MiiAnim.Core.Assets.FemaleBody.glb" />

        <!-- Compile Items -->
        <Compile Update="Views\Components\ListActionButton.axaml.cs">
            <DependentUpon>ListActionButton.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Features\WiiManagement\MiiManagement\Views\Dialogs\MiiEditor\EditorEmpty.axaml.cs">
            <DependentUpon>EditorEmpty.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Features\WheelWizardData\Views\CommunityCountBadge.axaml.cs">
            <DependentUpon>CommunityCountBadge.axaml</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup Label="Additional Files">
        <AdditionalFiles Include="Views\Styles\Resources\Constants.axaml" />
        <AdditionalFiles Include="Views\Styles\Resources\Icons.axaml" />
        <AdditionalFiles Include="Views\Styles\Styles\ButtonStyles.axaml" />
        <AdditionalFiles Include="Views\Styles\Styles\TextStyles.axaml" />
        <AdditionalFiles Include="Views\DesignTime\Controls\IconExampleComponent.axaml" />
    </ItemGroup>

    <ItemGroup Label="Fonts">
        <AvaloniaResource Include="Resources\Fonts\Roboto-Regular.ttf" />
        <AvaloniaResource Include="Resources\Fonts\ctmkf.ttf" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\Flatpak\io.github.TeamWheelWizard.WheelWizard.png" Link="Resources\Images\AppIcon.png" />
    </ItemGroup>

    <ItemGroup Label="Mii Rendering Resources">
        <EmbeddedResource Include="Features\MiiRendering\Resources\*.rmdl" />
    </ItemGroup>

    <ItemGroup Label="Patches Resources">
        <EmbeddedResource Include="Features\Patches\Resources\*.json" />
    </ItemGroup>

</Project>

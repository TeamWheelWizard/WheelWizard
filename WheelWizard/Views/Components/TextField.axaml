<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:WheelWizard.Views.Components">
    <Style Selector="components|TextField">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <components:FormFieldLabel Text="{TemplateBinding Label}" TipText="{TemplateBinding TipText}"
                        IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBox Name="PART_Input" Text="{TemplateBinding Text, Mode=TwoWay}"
                             PlaceholderText="{TemplateBinding PlaceholderText}" IsReadOnly="{TemplateBinding IsReadOnly}"
                             AutomationProperties.Name="{TemplateBinding Label}" />
                    <components:IconLabel Text="{TemplateBinding ErrorText}" IsVisible="{TemplateBinding HasError}"
                        Foreground="{StaticResource Danger600}" IconData="{StaticResource WarningTriangle}"
                        IconSize="15" FontSize="13" Margin="4,4,0,0" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>

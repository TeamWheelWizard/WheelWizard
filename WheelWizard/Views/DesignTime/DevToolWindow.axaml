<dialogBase:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                   x:Class="WheelWizard.Views.DesignTime.DevToolWindow"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base">
    <Grid Width="520" MaxHeight="600">
        <ScrollViewer>
            <StackPanel>
                <!-- MONITORING BIT -->
                <TextBlock Text="Monitoring" HorizontalAlignment="Left" VerticalAlignment="Top" Classes="PageTitleText" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <components:StatusBadge x:Name="MiiImagesCashed" Variant="Gray" Text="0"
                                         TipPlacement="Top" Margin="10,0,0,0"
                                         IconData="{StaticResource UserCircle}"
                                         TipText="Amount of Mii-images cashed in memory" />
                    <components:StatusBadge x:Name="RrRefreshTimeLeft" Variant="Gray" Text="0"
                                         TipPlacement="Top" Margin="10,0,0,0"
                                         IconData="{StaticResource Hourglass}"
                                         TipText="Time until the next RR rooms refresh" />
                </StackPanel>
                <Border Background="{StaticResource BackgroundLineColor}" Margin="-10,10" Height="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                
                
                <!-- TOOLS BIT -->
                <TextBlock Text="Tools" HorizontalAlignment="Left" VerticalAlignment="Top" Classes="PageTitleText" />
                <components:ToggleCheckBox Margin="0,2" IsChecked="False" Variant="Switch"
                          x:Name="WhWzTopMost" Click="WhWzTopMost_OnClick">
                    Wheel Wizard always on top
                </components:ToggleCheckBox>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8" ColumnSpacing="8" RowSpacing="6">
                <components:ActionButton Grid.Row="0" Grid.Column="0" Tone="Brand" Text="Mii Channel" IconData="{StaticResource DolphinIcon}"
                                   HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="MiiChannel_OnClick" />
                
                <components:ActionButton Grid.Row="0" Grid.Column="1" Tone="Secondary" Text="Show Mii Animator" HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="ShowMiiAnimator_OnClick" />
                <components:ActionButton Grid.Row="1" Grid.Column="0" Tone="Secondary" Text="Force enable layout" HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="ForceEnableLayout_OnClick" />
                <components:ActionButton Grid.Row="1" Grid.Column="1" Tone="Secondary" Text="Kitchen Sink"
                                   IconData="{StaticResource Sink}" HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="KitchenSink_OnClick" />
                <components:ActionButton Grid.Row="2" Grid.Column="0" Tone="Secondary" Text="Clear Cache" HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="ClearCache_OnClick" />
                <components:ActionButton Grid.Row="2" Grid.Column="1" Tone="Primary" Text="Hide all dev things" HorizontalAlignment="Stretch" Margin="0,2"
                                   Click="HideDevelopmentFeatures_OnClick" />
                </Grid>
                <Border Background="{StaticResource BackgroundLineColor}" Margin="-10,10" Height="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                
                
                <!-- POPUP TESTS -->
                <TextBlock Text="Popups" HorizontalAlignment="Left" VerticalAlignment="Top" Classes="PageTitleText" />
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                    <components:ActionButton Tone="Secondary" Text="progress popup" x:Name="ProgressPopupTest" HorizontalAlignment="Left" Margin="0,2"
                                       Click="TestProgressPopup_OnClick" />
                    <components:ActionButton Tone="Secondary" Text="message popups" HorizontalAlignment="Left" Margin="0,2"
                                       Click="TestMessagePopups_OnClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                    <components:ActionButton Tone="Secondary" Text="Yes No popup" x:Name="YesNoPopupButton" HorizontalAlignment="Left" Margin="0,2"
                                       Click="YesNoPopup_OnClick" />
                    <components:ActionButton Tone="Secondary" Text="Options popup" x:Name="OptionsPopupButton" HorizontalAlignment="Left" Margin="0,2"
                                       Click="OptionsPopup_OnClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</dialogBase:PopupContent>

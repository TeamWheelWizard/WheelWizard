<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             x:Class="WheelWizard.Views.DesignTime.KitchenSinkPage">
    <UserControl.Styles>
        <Style Selector="Border.KitchenSinkSectionBlock">
            <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource Neutral950}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.KitchenSinkSectionBlock.BlockBackground900">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral950}" />
        </Style>
        <Style Selector="Border.KitchenSinkAttributeTable">
            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}" />
        </Style>
        <Style Selector="Border.KitchenSinkAttributeRow">
            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.KitchenSinkAttributeHeader">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector="Border.BlockBackground900 Border.KitchenSinkAttributeHeader">
            <Setter Property="Background" Value="{StaticResource Neutral800}" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <Border Grid.Row="1" Background="{StaticResource BackgroundLineColor}" Height="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        <components:ToggleCheckBox x:Name="BackgroundSwitch" Variant="Switch"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3,8,3,0"
                  Content="Light background" IsChecked="True"
                  IsCheckedChanged="BackgroundSwitch_OnIsCheckedChanged" />
        <TextBlock Text="Kitchen Sink" Classes="PageTitleText" VerticalAlignment="Bottom" />
        <components:Dropdown x:Name="ComponentSelector" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  MinWidth="150" Margin="0,0,3,8" SelectionChanged="ComponentSelector_OnSelectionChanged" />
        <ScrollViewer Grid.Row="1" Margin="0,10,0,1" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ToggleCard" Classes="KitchenSinkSectionBlock BlockBackground900"
                    VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="ToggleExamples" Spacing="24" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>

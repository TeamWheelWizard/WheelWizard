<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WheelWizard.Views.Behaviors">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="WheelWizardScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource Neutral900}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover, ^:pressed">
                <Setter Property="Background" Value="{StaticResource Neutral700}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="WheelWizardScrollBar" TargetType="ScrollBar">
            <Style Selector="^:vertical">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="14" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Track Margin="6,8,2,8" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb MinHeight="18" Theme="{StaticResource WheelWizardScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="^:horizontal">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Track Margin="8,6,8,2" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="Horizontal">
                            <Track.Thumb>
                                <Thumb MinWidth="18" Theme="{StaticResource WheelWizardScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ScrollViewer">
        <Setter Property="behaviors:HorizontalPanBehavior.IsEnabled" Value="True" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Grid.RowSpan" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
        <Setter Property="RenderTransform">
            <TranslateTransform X="11" />
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource Neutral600}" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover, ScrollBar:horizontal /template/ Thumb:pressed">
        <Setter Property="Background" Value="{StaticResource Neutral400}" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Theme" Value="{StaticResource WheelWizardScrollBar}" />
    </Style>

    <Style Selector="Border.SettingsBlockStyle">
        <Setter Property="Background" Value="{StaticResource Neutral900}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="10" />
        <!-- When there is an error or something, you can change the color here to something, then the edge also changes -->
        <Setter Property="BorderBrush" Value="{StaticResource Neutral900}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.SettingsRowStyle">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.SettingsRowTop">
        <Setter Property="CornerRadius" Value="12,12,5,5" />
    </Style>
    <Style Selector="Border.SettingsRowMiddle">
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.SettingsRowBottom">
        <Setter Property="CornerRadius" Value="5,5,12,12" />
    </Style>
    <Style Selector="Border.SettingsRowSingle">
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.SettingsBottomSpacer">
        <Setter Property="Height" Value="32" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    
    <Style Selector="Border.AboutBlockStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Padding" Value="10" />
        <!-- When there is an error or something, you can change the color here to something, then the edge also changes -->
        <Setter Property="BorderBrush" Value="{StaticResource Neutral800}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <Style Selector="Border.AboutBlockLineStyle">
        <Setter Property="Background" Value="{StaticResource Neutral800}" />
        <Setter Property="Margin" Value="10,-10" />
        <Setter Property="Width" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter, ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    
    <Style Selector="ListBoxItem Border.BoxItemBackground">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Background" Value="{StaticResource Neutral900}"/>
    </Style>
    <Style Selector="ListBoxItem Border.BoxItemBackground:pointerover">
        <Setter Property="Background" Value="{StaticResource Neutral700}"/>
    </Style>
    
    <Style Selector="Control">
        <Setter Property="ToolTip.Placement" Value="Top"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource BlackIsh}"/>
        <Setter Property="Foreground" Value="{StaticResource Neutral300}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_ToolTipChrome" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Grid.Column="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Path Grid.Row="1" Grid.Column="1"
                          x:Name="PART_ToolTipTail"
                          Width="12"
                          Height="8"
                          Data="M 0 0 L 12 0 L 6 8 Z"
                          Fill="{TemplateBinding Background}"
                          HorizontalAlignment="Center"
                          Margin="0,-1,0,0"
                          Stretch="Fill"
                          IsHitTestVisible="False"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToolTip.BubblePointerLeft /template/ Path#PART_ToolTipTail">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="16,-1,0,0"/>
    </Style>
    <Style Selector="ToolTip.BubblePointerMiddle /template/ Path#PART_ToolTipTail">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,-1,0,0"/>
    </Style>
    <Style Selector="ToolTip.BubblePointerRight /template/ Path#PART_ToolTipTail">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,-1,16,0"/>
    </Style>

    <Style Selector="ToolTip.BubbleSideLeft /template/ Path#PART_ToolTipTail, ToolTip.BubbleSideRight /template/ Path#PART_ToolTipTail">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToolTip.BubbleSideLeft /template/ Path#PART_ToolTipTail">
        <Setter Property="Grid.Column" Value="2"/>
        <Setter Property="Data" Value="M 0 0 L 8 6 L 0 12 Z"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
    </Style>
    <Style Selector="ToolTip.BubbleSideRight /template/ Path#PART_ToolTipTail">
        <Setter Property="Grid.Column" Value="0"/>
        <Setter Property="Data" Value="M 8 0 L 0 6 L 8 12 Z"/>
        <Setter Property="Margin" Value="0,0,-1,0"/>
    </Style>

    <Style Selector="ToolTip.BubbleAnimateIn /template/ Grid#PART_ToolTipChrome">
        <Style.Animations>
            <Animation Duration="0:0:0.04" IterationCount="1" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="11"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ToolTip.BubbleAnimateOut /template/ Grid#PART_ToolTipChrome">
        <Style.Animations>
            <Animation Duration="0:0:0.04" IterationCount="1" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="11"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ToolTip TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Neutral300}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BlackIsh}"/>
        <Setter Property="Foreground" Value="{StaticResource Neutral300}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Neutral300}"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource Neutral50}"/>
    </Style>
    
    <Style Selector="ContextMenu Separator">
        <Setter Property="Background" Value="{StaticResource Neutral900}"/>
    </Style>
</Styles>

<dialogBase:ModalContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                   x:Class="WheelWizard.Views.Dialogs.OptionsWindow"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base">
    <!-- Max Height is practically unreachable, no way that you have so many options -->
    <Grid MaxHeight="800" RowDefinitions="Auto,*">
        <components:ModalHeading Margin="0,0,0,12">
            <TextBlock Classes="TitleText" Text="{ReflectionBinding ModalTitle, RelativeSource={RelativeSource AncestorType=dialogBase:ModalContent}}" TextWrapping="Wrap" />
        </components:ModalHeading>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" x:Name="OptionList">
                <!-- the list off Options are generated in this thing here -->
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</dialogBase:ModalContent>

<dialogBase:ModalContent x:Class="WheelWizard.Views.Dialogs.ProgressWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:components="clr-namespace:WheelWizard.Views.Components"
                    xmlns:loc="clr-namespace:WheelWizard.Localization"
                    ClipToBounds="False"
                    mc:Ignorable="d" d:DesignHeight="170" d:DesignWidth="400"
        xmlns:dialogBase="clr-namespace:WheelWizard.Views.Dialogs.Base">
    <Grid Width="400" MinHeight="150" MaxHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Goal Description -->
        <Border Grid.Row="0" Background="{StaticResource Brand500}" Margin="{StaticResource NegativeEdgeGap}" x:Name="GoalBorder">
            <components:ModalHeading Margin="{StaticResource EdgeGap}">
                <SelectableTextBlock x:Name="GoalTextBlock"
                                     Classes="TitleText" FontSize="18" TextTrimming="CharacterEllipsis"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Foreground="{StaticResource Brand50}" />
            </components:ModalHeading>
        </Border>

        <Grid Grid.Row="1" Margin="0,10" RowDefinitions="*,Auto">
            <!-- Extra Information -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <SelectableTextBlock Classes="BodyText" x:Name="ExtraTextBlock"
                                         FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <SelectableTextBlock Classes="BodyText" x:Name="LiveTextBlock"
                                         FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" x:Name="ProgressBar" Height="20"
                         Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="False"
                         BorderThickness="0"
                         Foreground="{StaticResource Brand500}"
                         Background="{StaticResource BackgroundLineColor}"
                         Margin="0,10,0,0" />

        </Grid>
        <components:ActionButton Grid.Row="2"
                           x:Name="CancelButton"
                           Text="{loc:T action.cancel}"
                           IsVisible="False"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"
                           Click="CancelButton_OnClick"  Tone="Danger"/>
    </Grid>
</dialogBase:ModalContent>

<base:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:base="clr-namespace:WheelWizard.Views.Popups.Base"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   xmlns:patterns="clr-namespace:WheelWizard.Views.Patterns"
                   xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
                   xmlns:popups="clr-namespace:WheelWizard.Views.Popups"
                   x:Class="WheelWizard.Views.Popups.ProfileVisibilityWindow"
                   x:DataType="popups:ProfileVisibilityWindow">
    <Grid Width="520" MaxHeight="640" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="TitleText" FontSize="20" Text="Choose visible profiles" />
            <TextBlock Classes="TinyText" TextWrapping="Wrap"
                       Text="Select up to four local or cloud profiles that should be accessible in-game. No save or cloud profile is deleted when deselecting." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,8" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="popups:ProfileVisibilityChoice">
                        <Border Height="60" Margin="0,0,0,8" Background="Transparent"
                                BorderBrush="{StaticResource Neutral600}" BorderThickness="1"
                                CornerRadius="{StaticResource GlobalCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <Grid Margin="5,0" ColumnDefinitions="58,*,Auto,Auto">
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Classes="SidebarSectionText" Text="{Binding Name}"
                                                   Foreground="{StaticResource Neutral200}" Margin="10,0,0,0" />
                                        <TextBlock Classes="TinyText" Text="{Binding FriendCode}"
                                                   Foreground="{StaticResource Neutral400}" Margin="10,0,0,0" />
                                        <TextBlock Classes="TinyText" Text="{Binding LastUpdated}"
                                                   Foreground="{StaticResource Neutral500}" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" Width="32" Height="32" Margin="4" ToolTip.Tip="{Binding StorageStatus}">
                                        <!-- Cloud: source is in the cloud. -->
                                        <Path Data="M5,22 C2.8,22 1,20.2 1,18 C1,15.7 2.8,13.9 5.1,13.9 C5.8,10.5 8.6,8 12.1,8 C16.1,8 19.3,10.8 19.8,14.6 C22.2,14.8 24,16.7 24,19 C24,20.9 22.5,22 20.5,22 L5,22"
                                              Fill="Transparent" Stroke="{StaticResource Neutral300}" StrokeThickness="1.8" />
                                        <!-- A slash makes the cloud icon mean local-only. -->
                                        <Line IsVisible="{Binding IsLocalOnly}" StartPoint="2,30" EndPoint="30,2"
                                              Stroke="{StaticResource Neutral300}" StrokeThickness="2.2" />
                                        <!-- A small laptop denotes a cloud profile already available on this device. -->
                                        <Path IsVisible="{Binding IsCloudAndLocal}"
                                              Data="M16,18 L27,18 L27,25 L16,25 Z M14,26 L29,26 L31,29 L12,29 Z"
                                              Fill="{StaticResource Neutral800}" Stroke="{StaticResource Neutral300}" StrokeThickness="1.4" />
                                    </Grid>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                              AutomationProperties.Name="{Binding Name}"
                                              AutomationProperties.HelpText="{Binding FriendCode}"
                                              VerticalAlignment="Center" Margin="8" />
                                </Grid>
                                <patterns:MiiImageLoader Width="80" Height="80" Margin="-7,0,0,1"
                                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                         IsHitTestVisible="False" LoadingColor="Transparent"
                                                         FallBackColor="{StaticResource Neutral600}" Mii="{Binding Mii}"
                                                         ImageVariant="{x:Static miiVars:MiiImageVariants.FriendsSideProfile}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock x:Name="Validation" Classes="TinyText" Foreground="{StaticResource Danger400}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <components:Button Text="Cancel" Click="Cancel_OnClick" />
                <components:Button Text="Show selected profiles" Variant="Primary" Click="Apply_OnClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</base:PopupContent>

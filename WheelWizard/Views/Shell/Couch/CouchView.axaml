<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             x:Class="WheelWizard.Views.Shell.Couch.CouchView"
             FontSize="18">
    <UserControl.Styles>
        <Style Selector="components|ActionButton.couch-navigation">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Tone" Value="Secondary" />
            <Setter Property="Variant" Value="Ghost" />
        </Style>
        <Style Selector="components|ActionButton.couch-navigation.selected">
            <Setter Property="Foreground" Value="{DynamicResource Brand300}" />
            <Setter Property="Background" Value="{DynamicResource FrameColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brand400}" />
        </Style>
        <Style Selector="components|ActionButton /template/ Border#PART_FocusRing">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="20,12,20,12" RowSpacing="12">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="NavigationButtons" Orientation="Horizontal" Spacing="4" />
        </ScrollViewer>
        <Border Grid.Row="1" Background="{DynamicResource BackgroundColor}"
                CornerRadius="{StaticResource GlobalCornerRadius}" Padding="{StaticResource EdgeGap}" ClipToBounds="True">
            <Grid x:Name="PageHost" />
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock x:Name="InputHints" Classes="BodyText" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <components:ActionButton x:Name="BackButton" Tone="Secondary" Variant="Ghost"
                                         IconData="{StaticResource ArrowLeft}" MinHeight="48" Padding="16,10" FontSize="16" />
                <components:ActionButton x:Name="FullscreenButton" Tone="Secondary" Variant="Ghost"
                                         MinHeight="48" Padding="16,10" FontSize="16" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             mc:Ignorable="d" d:DesignWidth="490" d:DesignHeight="830"
             ClipToBounds="False"
             x:DataType="shellViewModels:HomeViewModel"
             x:Class="WheelWizard.Views.Shell.Views.HomePage"
        xmlns:shellViewModels="clr-namespace:WheelWizard.Views.Shell.ViewModels"
        xmlns:shellControls="clr-namespace:WheelWizard.Views.Shell.Controls"
        xmlns:miiImages="clr-namespace:WheelWizard.MiiImages.Views"
        xmlns:miiVariants="clr-namespace:WheelWizard.MiiImages.Domain"
        xmlns:miiAnimations="clr-namespace:WheelWizard.MiiAnimations">
    <UserControl.Styles>
        <Style Selector="components|ActionButton#DolphinButton /template/ PathIcon#PART_LeftIcon">
            <Setter Property="RenderTransform" Value="scale(2.5)" />
        </Style>
        <Style Selector="Button#CouchProfileButton">
            <Setter Property="Background" Value="{StaticResource FrameColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource Neutral700}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource GlobalCornerRadius}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button#CouchProfileButton:pointerover, Button#CouchProfileButton:pressed">
            <Setter Property="BorderBrush" Value="{StaticResource Brand400}" />
        </Style>
        <Style Selector="shellControls|WheelTrail.HoverEnterTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="ExponentialEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                    </KeyFrame>
                </Animation>
                <Animation Duration="0:0:3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="WheelRotation" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="shellControls|WheelTrail.HoverExitTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.8" FillMode="Forward" Easing="BounceEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="0" />
                    </KeyFrame>
                </Animation>
                <Animation Duration="0:0:0.8" FillMode="Forward" Easing="BounceEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="WheelRotation" Value="100" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="shellControls|WheelTrail.ActivateTrailFromHover">
            <Style.Animations>
                <Animation Duration="0:0:0.6"
                           FillMode="Forward" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="-50" />
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-1200" />
                        <Setter Property="WheelRotation" Value="360" />
                        <Setter Property="IsVisible" Value="False" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="shellControls|WheelTrail.ActivateTrailFromIdle">
            <Style.Animations>
                <Animation Duration="0:0:0.6"
                           FillMode="Forward" Easing="CubicEaseIn">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="0" />
                        <Setter Property="WheelRotation" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="-1200" />
                        <Setter Property="WheelRotation" Value="360" />
                        <Setter Property="IsVisible" Value="False" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        
        <Style Selector="shellControls|WheelTrail.EntranceTrail">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.3"
                           FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ExtendedHeight" Value="250" />
                        <Setter Property="WheelRotation" Value="-200" />
                        <Setter Property="IsVisible" Value="True" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ExtendedHeight" Value="0" />
                        <Setter Property="WheelRotation" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        
    </UserControl.Styles>
    <Grid>
    <Grid x:Name="CompleteGrid" IsEnabled="{Binding IsInteractable}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TopRowSize}" />
            <!-- This is the total height as the (Title + infoSection) - (padding) -->
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />
        <TextBlock Grid.Row="0" Text="{loc:T page_title.home}" HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Classes="PageTitleText" />
        <Border Grid.Row="1" Background="{StaticResource BackgroundLineColor}" Height="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom" />



        <!-- These are invisible by default, they will be set to visible once the button is turned to green 
            This way we don't have to take in account whether or not an animation can play, since if it plays but it is not allowed, it will be invisible anyways -->
        <shellControls:WheelTrail Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail1"
                               Width="137" Angle="45" Y="-60" X="-20" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Brand400}" Foreground="{StaticResource Brand700}" />
        <shellControls:WheelTrail Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail2"
                               Width="137" Angle="45" Y="-40" X="170" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Brand600}" Foreground="{StaticResource Brand800}" />
        <shellControls:WheelTrail Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" x:Name="HomeTrail3"
                               Width="137" Angle="45" Y="165" X="175" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Brand200}" Foreground="{StaticResource Brand600}" />

        <Border Grid.Row="1" Height="630" Width="250" CornerRadius="125,125,0,0" VerticalAlignment="Bottom"
                Background="{StaticResource FrameColor}" Margin="{StaticResource NegativeEdgeGap}">
            <PathIcon HorizontalAlignment="Center" VerticalAlignment="Top"
                      Data="{StaticResource WheelIcon}"
                      x:Name="WheelIcon"
                      Foreground="{StaticResource Neutral600}"
                      Width="200" Height="200" Margin="0,25" />
            <!-- 
                Note that this icon should have the same margin on each side. Decide a padding/border, enter that number in the margin at tb.
                Then, double this number, take the width of the parent container, and subtract the doubled margin. 
                This will give you the width & height of the icon.
            -->
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="180" Margin="0,220">

            <TextBlock HorizontalAlignment="Center" Classes="TitleText" x:Name="GameTitle" Text="{Binding GameTitle}" />
            <components:ActionButton x:Name="PlayButton" IsLoading="{Binding IsLoading}"
                               IsEnabled="{Binding CanExecuteMain}"
                               Tone="{Binding ButtonTone}"
                               Text="{Binding ButtonText}" PointerEntered="PlayButton_OnPointerEntered"
                               PointerExited="PlayButton_OnPointerExit"
                               IconData="{StaticResource Play}"
                               Click="PlayButton_Click"
                               Margin="0,20,0,0" />
            <components:ActionButton Tone="Secondary" x:Name="DolphinButton"
                               IsEnabled="{Binding CanLaunchDolphin}"
                               IsVisible="{Binding IsDolphinVisible}"
                               IconData="{StaticResource DolphinIcon}"
                               Height="40"
                               Click="DolphinButton_OnClick"
                               Width="100" Margin="0,6,0,0" />
            <!-- removed tooltip for dolphin startup button as this doesn't look so nice, and I think everyone knows it by the dolphin icon -->
            <!-- ToolTip.Tip="{loc:T action.launch_dolphin}"
                               ToolTip.Placement="Top"
                               ToolTip.ShowDelay="50"  -->
        </StackPanel>
        
        <shellControls:WheelTrail Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="HomeTrail4"
                               Width="137" Angle="-35" X="-160" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Brand400}" Foreground="{StaticResource Brand700}" />
        <shellControls:WheelTrail Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="HomeTrail5"
                               Width="137" Angle="-35" X="40" Y="30" ExtendedHeight="1000" IsVisible="False"
                               Background="{StaticResource Brand600}" Foreground="{StaticResource Brand800}" />
    </Grid>
        <ScrollViewer x:Name="CouchHome" IsVisible="False" IsEnabled="{Binding IsInteractable}" Margin="20"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="32" Height="{Binding #CouchHome.Viewport.Height}">
                <Button x:Name="CouchProfileButton" Click="CouchProfileButton_OnClick" IsEnabled="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        AutomationProperties.Name="{loc:T couch.open_primary_profile}">
                    <Grid RowDefinitions="Auto,*,Auto" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"
                                      Foreground="{StaticResource Brand300}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T state.primary}" Foreground="{StaticResource Neutral300}" FontSize="14" />
                        </StackPanel>
                        <Grid Grid.Row="1" MinHeight="120" RowDefinitions="4*,*">
                            <Ellipse Grid.Row="1" Height="40" MaxWidth="220" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Fill="{StaticResource Neutral800}" Stroke="{StaticResource Neutral600}" StrokeThickness="1" />
                            <miiImages:MiiAnimatedImage x:Name="CouchPrimaryMii" Grid.RowSpan="2"
                                                       MaxWidth="420" LoadingColor="Transparent"
                                                       FallBackColor="{StaticResource Neutral600}"
                                                       Performance="{x:Static miiAnimations:MiiPerformances.HomePlayer}"
                                                       ImageVariant="{x:Static miiVariants:MiiImageVariants.FullBodyCarousel}" />
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock x:Name="CouchPrimaryName" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Neutral100}" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock Text="{loc:T couch.open_primary_profile}" FontSize="14"
                                       Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center"
                                       IsVisible="{Binding #CouchProfileButton.IsEnabled}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                    <PathIcon Data="{StaticResource WheelIcon}" Width="48" Height="48"
                              Foreground="{StaticResource Brand400}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding GameTitle}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                    <components:ActionButton x:Name="CouchPlayButton" IsLoading="{Binding IsLoading}"
                                             IsEnabled="{Binding CanExecuteMain}" Tone="{Binding ButtonTone}"
                                             Text="{Binding ButtonText}" IconData="{StaticResource Play}"
                                             MinHeight="64" HorizontalAlignment="Stretch" Click="PlayButton_Click" />
                    <components:ActionButton Tone="Secondary" IsEnabled="{Binding CanLaunchDolphin}"
                                             IsVisible="{Binding IsDolphinVisible}" Text="{loc:T action.launch_dolphin}"
                                             MinHeight="56" IconData="{StaticResource DolphinIcon}"
                                             HorizontalAlignment="Stretch" Click="DolphinButton_OnClick" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

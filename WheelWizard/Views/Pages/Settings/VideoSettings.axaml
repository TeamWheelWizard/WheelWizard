<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="444" d:DesignHeight="716"
             xmlns:settings="clr-namespace:WheelWizard.Views.Pages.Settings"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components1="clr-namespace:WheelWizard.Views.Components"
             x:Class="WheelWizard.Views.Pages.Settings.VideoSettings">
    
    <Grid x:Name="VideoBorder">
        <StackPanel Margin="0,15,0,0">

            <Border Padding="4" Margin="0,-10,0,10"  x:Name="DisabledWarningText"
                    CornerRadius="{StaticResource GlobalCornerRadius}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Background="{StaticResource Warning600}">
                <TextBlock HorizontalAlignment="Center" Classes="BodyText"
                           FontWeight="SemiBold" Text="{loc:T helper_text.topbar.location_warning}"
                           Foreground="{StaticResource BackgroundColor}" >
                </TextBlock>
            </Border>

            <!-- Graphics Section -->
            <components1:FormFieldLabel Text="{loc:T section.graphics}" />
            <Border Classes="SettingsBlockStyle" x:Name="GraphicsBorder">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T section.resolution}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.resolution_scale}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="ResolutionDropdown"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="-10,10" Background="{StaticResource Neutral950}" />

                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T option.renderer}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.renderer}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="RendererDropdown"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="-10,10" Background="{StaticResource Neutral950}" />

                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T option.v_sync}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.v_sync}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="VSyncButton"
                                  Classes="SwitchDark"
                                  IsChecked="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="-10,10" Background="{StaticResource Neutral950}" />

                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <components1:FormFieldLabel Grid.Column="0"
                                                    Margin="0,0,16,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Text="{loc:T option.show_fps}" />
                        <CheckBox Grid.Column="1"
                                  x:Name="ShowFPSButton"
                                  Classes="SwitchDark"
                                  IsChecked="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General Section -->
            <components1:FormFieldLabel Text="{loc:T section.general}" />
            <Border Classes="SettingsBlockStyle" x:Name="GeneralBorder">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T option.recommended}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.recommended}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="RecommendedButton"
                                  Classes="SwitchDark"
                                  IsChecked="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="-10,10" Background="{StaticResource Neutral950}" />

                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T option.force_disable_wiimote}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.force_disable_wiimote}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="DisableForce"
                                  Classes="SwitchDark"
                                  IsChecked="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Margin="-10,10" Background="{StaticResource Neutral950}" />

                    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Spacing="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <components1:FormFieldLabel Text="{loc:T option.launch_with_dolphin}" />
                            <TextBlock Classes="TinyText"
                                       Text="{loc:T helper_text.launch_with_dolphin}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="LaunchWithDolphin"
                                  Classes="SwitchDark"
                                  IsChecked="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="SettingsBottomSpacer" />
        </StackPanel>
    </Grid>
</UserControl>
